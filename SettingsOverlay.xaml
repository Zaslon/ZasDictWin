<UserControl x:Class="ZasDictWin.Views.Overlays.SettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZasDictWin.ViewModels">

    <Border Style="{StaticResource Card}" MaxWidth="820" Margin="40,28" Padding="0">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="24,18" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                           FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=19}" />
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="24,14" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="キャンセル" Command="{Binding CloseCommand}" />
                    <Button Content="適用" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Margin="0" />
                </StackPanel>
            </Border>

            <!-- スクロール領域はタブの高さいっぱいまで使う。高さを固定すると
                 文字サイズ倍率を上げたときに数行しか見えなくなる。 -->
            <TabControl Margin="24,14,24,0">
                <TabItem Header="表示・動作">
                    <!-- 設定は縦にだけ流す。横スクロールを許すと折り返し幅が測定のたびに変わり、
                         上下の並びがずれて見える（横に広い内容は折り返しと末尾省略で吸収させる） -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,14,0,14">
                            <TextBlock Text="文字サイズ倍率" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding FontScale}" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Text="カスタム字順" Style="{StaticResource Label}" Margin="0,16,0,4" />
                            <TextBox Text="{Binding SortOrder}" FontFamily="Consolas" />

                            <CheckBox Content="編集したら自動で上書き保存する" IsChecked="{Binding AutoSave}" Margin="0,16,0,0" />

                            <TextBlock Text="イジェール文字フォント（Heksa）" Style="{StaticResource SectionHeading}" />
                            <CheckBox Content="Heksa を有効にする" IsChecked="{Binding HeksaEnabled}" />
                            <TextBlock Style="{StaticResource Label}" Margin="0,2,0,0"
                                       Text="見出し語・検索欄・単語エディタの綴り欄をイジェール文字フォントで表示します（.ttf / .otf が必要です）。" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="ファイルを選択" Command="{Binding PickFontCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding HeksaFontPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Text="フォントファイルが読み込めないため、標準フォントで表示されます。"
                                       Foreground="{StaticResource Danger}" Margin="0,8,0,0"
                                       FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}"
                                       Visibility="{Binding IsFontMissing, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="サンプル：eaoiu heksa" Margin="0,8,0,0"
                                       FontFamily="{Binding PreviewFontFamily}"
                                       FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=20}"
                                       Visibility="{Binding HasPreviewFont, Converter={StaticResource BoolVis}}" />

                            <DockPanel Margin="0,16,0,6">
                                <Button DockPanel.Dock="Right" Content="既定に戻す" Style="{StaticResource GhostButton}"
                                        Command="{Binding ResetReciprocalCommand}" Margin="0" />
                                <TextBlock Text="関係の対照表（1行に 見出し=相手側）" Style="{StaticResource SectionHeading}"
                                           Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox Text="{Binding ReciprocalText}" AcceptsReturn="True" MinHeight="140"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="辞書依存">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,14,0,14">
                            <TextBlock Text="辞書が開かれていないため編集できません。" Foreground="{StaticResource Muted}"
                                       Visibility="{Binding HasDictionary, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                            <StackPanel Visibility="{Binding HasDictionary, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="punctuations（並べ替えで無視する文字）" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding Punctuations}" FontFamily="Consolas" />
                                <TextBlock Text="ignoredPattern（前方・後方・完全一致で見出し語から除去する正規表現）"
                                           Style="{StaticResource Label}" Margin="0,16,0,4" />
                                <TextBox Text="{Binding IgnoredPattern}" FontFamily="Consolas" />
                                <TextBlock Text="この 2 つは辞書ファイルの zpdicOnline に書き戻されます。"
                                           Style="{StaticResource Label}" Margin="0,10,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="単語ウィンドウ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,14,0,14">
                            <TextBlock Text="背景色（クロマキーなら #00B140 など。透過するなら Transparent）" Style="{StaticResource Label}" />
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="44" Height="32" CornerRadius="6" Margin="8,0,0,0"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        Background="{Binding StreamBackground, Converter={StaticResource StringBrush}}" />
                                <TextBox Text="{Binding StreamBackground, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                            </DockPanel>

                            <TextBlock Text="文字サイズ倍率" Style="{StaticResource Label}" Margin="0,16,0,4" />
                            <TextBox Text="{Binding StreamFontScale}" Width="120" HorizontalAlignment="Left" />

                            <CheckBox Content="常に手前に表示する" IsChecked="{Binding StreamTopmost}" Margin="0,14,0,0" />
                            <CheckBox Content="訳語を表示する" IsChecked="{Binding StreamShowTranslations}" />
                            <CheckBox Content="内容（語源・用例など）も表示する" IsChecked="{Binding StreamShowContents}" />

                            <TextBlock Style="{StaticResource Label}" Margin="0,14,0,0"
                                       Text="単語ウィンドウは独立したウィンドウです。OBS では［ウィンドウキャプチャ］で ZasDict 単語ウィンドウ を選び、クロマキーフィルタを掛けてください。" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="ブラウザ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,14,0,14">
                            <CheckBox Content="起動時に右サイドバーのブラウザを開く" IsChecked="{Binding BrowserVisible}" />

                            <TextBlock Text="開始 URL（空にすると既定の検索ページ）" Style="{StaticResource Label}" Margin="0,16,0,4" />
                            <TextBox Text="{Binding BrowserStartUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />

                            <TextBlock Style="{StaticResource Label}" Margin="0,14,0,0"
                                       Text="ヘッダーの［ブラウザ］ボタンでいつでも開閉できます。幅はサイドバーの左端をドラッグして調整し、設定は自動で保存されます。" />
                            <TextBlock Style="{StaticResource Label}" Margin="0,8,0,0"
                                       Text="WebView2 ランタイム（Microsoft Edge に同梱）を使用します。表示したページはメインウィンドウの一部なので、OBS ではウィンドウキャプチャにそのまま映ります。アドレス欄で Enter を押すと移動し、URL でない語句を入力した場合は検索になります。" />
                            <TextBlock Style="{StaticResource Label}" Margin="0,8,0,0"
                                       Text="WebView2 は WPF より手前に描画されるため、設定などのオーバーレイを開いている間は自動的に隠れます。ページ側にフォーカスがある間は Ctrl+S などのアプリのショートカットキーが効きません。" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
