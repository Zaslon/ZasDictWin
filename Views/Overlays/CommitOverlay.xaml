<UserControl x:Class="ZasDictWin.Views.Overlays.CommitOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZasDictWin.ViewModels"
             xmlns:v="clr-namespace:ZasDictWin.Views"
             xmlns:res="clr-namespace:ZasDictWin.Resources">

    <!-- ChoiceOverlay と同じく中央固定のカード。コミットメッセージだけ書き換えられる。 -->
    <Border Style="{StaticResource Card}" MaxWidth="520" MaxHeight="640" Margin="40,28"
            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" v:LocalizedText.Text="{Binding Title}" FontWeight="SemiBold"
                       FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=19}" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button v:LocalizedText.Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CancelCommand}" />
                <Button v:LocalizedText.Content="{x:Static res:Strings.GitHub_CommitButton}" Style="{StaticResource PrimaryButton}" Command="{Binding CommitCommand}" Margin="0" />
            </StackPanel>

            <StackPanel Margin="0,14,0,0">
                <TextBlock v:LocalizedText.Text="{x:Static res:Strings.GitHub_CommitSummaryLabel}" Style="{StaticResource Label}" />
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
                    <!-- 中身は「操作＋見出し語」の並び（辞書データ）。窓の UI フォントは継がせない。 -->
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontFamily="{x:Static res:Strings.ContentFont}" />
                </ScrollViewer>

                <TextBlock v:LocalizedText.Text="{x:Static res:Strings.GitHub_CommitMessageLabel}" Style="{StaticResource Label}" Margin="0,14,0,4" />
                <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" MaxLines="5"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
