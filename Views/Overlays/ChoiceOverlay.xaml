<UserControl x:Class="ZasDictWin.Views.Overlays.ChoiceOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ZasDictWin.Views"
             xmlns:r="clr-namespace:ZasDictWin.Root"
             xmlns:vm="clr-namespace:ZasDictWin.ViewModels">

    <!-- 他のオーバーレイと同じく、選択肢はスクロール領域の外に固定して本文だけ流す。
         障害の案内（App.UiException）は例外メッセージがそのまま入るうえ、文字サイズ倍率は
         3.0 まで上げられるので、素の StackPanel だとボタンが画面外へ押し出されて押せなくなる。
         Margin で上下に余白を残し、カードが窓の高さを超えないようにしている。 -->
    <Border Style="{StaticResource Card}" MaxWidth="520" MaxHeight="640" Margin="40,28"
            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
        <DockPanel>
            <!-- 開いたときのフォーカスはボタンではなくこの見出しに置く（ChoiceOverlay.xaml.cs）。直前の Enter や連打が
                 確認文を読む前にボタンを押してしまうのを防ぎ、支援技術には確認の内容から読ませるため。
                 見出しは Tab の移動先に含めない（Tab を押すと最初のボタンへ移る）。
                 （ZasDesignSystem rules.md「確認ポップアップの初期フォーカスをボタンに置かない」） -->
            <TextBlock x:Name="Heading" DockPanel.Dock="Top" v:LocalizedText.Text="{Binding Title}" FontWeight="SemiBold"
                       Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{x:Null}"
                       AutomationProperties.HeadingLevel="Level1"
                       FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=19}" />

            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Choices}" Margin="0,20,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChoiceItem}">
                        <Button v:LocalizedText.Content="{Binding Label}" r:IntentTrigger.OnClick="ConfirmChoiceSelected" r:IntentTrigger.Payload="{Binding Index}"
                                HorizontalContentAlignment="Center" Margin="0,0,0,8" Padding="14,10">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerFill}" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource OnFill}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 横スクロールは他のオーバーレイと同じく封じる。長い一文は折り返しで吸収させる。
                 本文には例外の内容やファイルのパスが入るので、選択してコピーできる v:SelectableText で描く
                 （ZasDesignSystem rules.md「表示した情報はコピーできるようにする」）。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <v:SelectableText Text="{Binding Message, Mode=OneWay, Converter={StaticResource PlainText}}"
                                  Foreground="{StaticResource Muted}" Margin="0,8,0,0"
                                  Visibility="{Binding Message, Converter={StaticResource NullVis}}" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
