<UserControl x:Class="ZasDictWin.Views.LegendPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZasDictWin.ViewModels"
             xmlns:v="clr-namespace:ZasDictWin.Views"
             xmlns:r="clr-namespace:ZasDictWin.Root"
             xmlns:res="clr-namespace:ZasDictWin.Resources">

    <Grid>
        <!-- 表示 -->
        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14,24,0">
                <Button v:LocalizedText.Content="{x:Static res:Strings.Common_Edit}" r:IntentTrigger.OnClick="LegendEditRequested"
                        IsEnabled="{Binding CanEdit}" Margin="0" />
            </StackPanel>
            <FlowDocumentScrollViewer x:Name="LegendView" Background="Transparent"
                                      IsSelectionEnabled="True"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="24,6,24,20" />
        </DockPanel>

        <!-- 編集。操作はフッタに固定し、本文が長くてもボタンが画面外に出ないようにする -->
        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}">
            <Border DockPanel.Dock="Bottom" Padding="24,12,24,18" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" v:LocalizedText.Content="{x:Static res:Strings.Common_Cancel}" Style="{StaticResource GhostButton}"
                            r:IntentTrigger.OnClick="LegendEditCancelled" Margin="0" />
                    <StackPanel Orientation="Horizontal">
                        <Button v:LocalizedText.Content="{x:Static res:Strings.Common_Save}" Style="{StaticResource PrimaryButton}" r:IntentTrigger.OnClick="LegendCommitted" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock DockPanel.Dock="Top" v:LocalizedText.Text="{Binding ValidationMessage}" Foreground="{StaticResource Danger}" Margin="24,14,24,0"
                       Visibility="{Binding ValidationMessage, Converter={StaticResource NullVis}}" />

            <!-- 凡例は辞書データなので、窓の UI フォントは継がせない。 -->
            <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Margin="24,14,24,14"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     FontFamily="{x:Static res:Strings.ContentFont}"
                     FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=13}" />
        </DockPanel>
    </Grid>
</UserControl>
