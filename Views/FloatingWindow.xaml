<Window x:Class="ZasDictWin.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZasDictWin.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Title, StringFormat={}ZasDict {0}}"
        MinWidth="260" MinHeight="200"
        Background="{StaticResource Ink}"
        FontFamily="Yu Gothic UI"
        FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=14}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStyle="None" ResizeMode="CanResize">

    <!-- 本体（MainWindow）と同じく標準の枠を持たない。CaptionHeight は 0 にし、ドラッグと
         最大化トグルは Header_MouseLeftButtonDown で自前実装する。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                             CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- 本体の窓から持ち出したタブ。DataContext は DockFloat。
         中身は本体とまったく同じ割り付け（枠と境目の入れ子）なので、この窓の中でも
         枠を割れるし、タブを掴んで本体へ運び戻すこともできる。
         枠の面と縁は DockGroupPanel が持つため、ここは題・最小化・最大化・終了と大きさだけを受け持つ。 -->
    <DockPanel>
        <!-- 標準の枠が無いので、このヘッダの余白自体が窓のドラッグ・つまみを兼ねる（本体と同じ理由）。 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderFill}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="10,5"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="最小化" Margin="0" />
                    <Button x:Name="MaximizeRestoreButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource IconButton}" Click="MaximizeRestore_Click" ToolTip="最大化" Margin="4,0,0,0" />
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource CloseIconButton}" Click="Close_Click" ToolTip="閉じる" Margin="4,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding Root}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </DockPanel>
</Window>
