<Window x:Class="ZasDictWin.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ZasDictWin.Views"
        xmlns:r="clr-namespace:ZasDictWin.Root"
        xmlns:vm="clr-namespace:ZasDictWin.ViewModels"
        xmlns:res="clr-namespace:ZasDictWin.Resources"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Title, Converter={StaticResource PlainText}, StringFormat={}ZasDict {0}}"
        Width="820" Height="760"
        MinWidth="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=UiScale, Converter={StaticResource ScaleMinSize}, ConverterParameter=w560}"
        MinHeight="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=UiScale, Converter={StaticResource ScaleMinSize}, ConverterParameter=h440}"
        Background="{StaticResource Ink}"
        BorderBrush="{StaticResource Line}" BorderThickness="1"
        FontFamily="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=UiFont}"
        FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=body}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize">

    <!-- 本体・独立ウィンドウ（FloatingWindow）と同じく標準の枠を持たない。CaptionHeight は 0 にし、
         ドラッグと閉じるは Header_MouseLeftButtonDown / Close_Click で自前実装する。
         設定はタブ束に混ざると誤操作しやすいので中央モーダルの見た目のまま、器だけ独立ウィンドウにしてある
         （OverlayViewModel は本来「画面内オーバーレイ」用だが、設定はストリーム配信の映り込みを気にしなくてよいため例外）。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                             CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 各タブの中身。内枠と文字の間の余白は ScrollViewer の Padding で取る（既定テンプレートでは
             Padding がスクロール領域側だけに掛かるので、スクロールバーは内枠の縁に付いたまま、
             文字だけが縁から離れる）。中の StackPanel に Margin を付けると、スクロールバーまで
             一緒に内側へ寄ってしまう。
             設定は縦にだけ流す。横スクロールを許すと折り返し幅が測定のたびに変わり、
             上下の並びがずれて見える（横に広い内容は折り返しと末尾省略で吸収させる）。 -->
        <Style x:Key="SettingsPage" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding"
                    Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleThickness}, ConverterParameter=20\,16\,20\,16}" />
        </Style>
    </Window.Resources>

    <!-- UI 倍率。本体の窓（MainWindow.xaml）と同じく中身の根に掛ける。 -->
    <Grid LayoutTransform="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=UiScaleTransform}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelSurface}" Background="{StaticResource HeaderFill}" BorderBrush="{StaticResource Divider}"
                BorderThickness="0,0,0,1" Padding="16,10"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Style="{StaticResource CloseIconButton}" Click="Close_Click" ToolTip="{x:Static res:Strings.Common_Close}"
                        AutomationProperties.Name="{x:Static res:Strings.Common_Close}" Margin="0" />
                <TextBlock v:LocalizedText.Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                           FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=h3}" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource FooterFill}" BorderBrush="{StaticResource Divider}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <!-- 戻る側を左、進む側を右に並べる（ZasDesignSystem rules.md「ボタンは戻る側を左、進む側を右に並べる」） -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button v:LocalizedText.Content="{x:Static res:Strings.Common_Cancel}" r:IntentTrigger.OnClick="WindowCloseRequested" />
                <Button v:LocalizedText.Content="{x:Static res:Strings.Settings_ApplyButton}" Style="{StaticResource PrimaryButton}" r:IntentTrigger.OnClick="SettingsApplyRequested" Margin="0" />
            </StackPanel>
        </Border>

        <!-- スクロール領域は窓の高さいっぱいまで使う。高さを固定すると
             文字サイズ倍率を上げたときに数行しか見えなくなる。
             周りの余白も文字サイズ倍率に追従させる。固定 px のままだと、倍率を上げるほど
             拡大された文字に対して余白だけ相対的に狭く見え、窓の縁に文字が迫って見える。 -->
        <TabControl Style="{StaticResource SettingsTabControl}"
                    Margin="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleThickness}, ConverterParameter=12\,10\,12\,12}">
            <TabItem v:LocalizedText.Header="{x:Static res:Strings.Settings_TabGeneral}">
                <ScrollViewer Style="{StaticResource SettingsPage}">
                    <StackPanel>
                        <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_Language}" Style="{StaticResource FieldLabel}" />
                        <!-- 選択肢は Resources/Languages.cs の一覧をそのまま出す。対応言語を増やす手順は
                             同ファイルのコメントを参照（新しい Strings.<コード>.resx を用意し、一覧に1行足すだけ）。 -->
                        <!-- ComboBox の一覧は別 HWND（Popup）になり OBS のウィンドウキャプチャに映らないため、
                             窓の中に一覧を描く v:DropDown を使う。DropDown は値も一覧も ContentFont で描くので、
                             言語名（どれもその言語自身での表記）が表示中の UI フォント（Idyerin なら Heksa）で崩れない。
                             Width は文字サイズ倍率に追従させる。ConverterParameter は倍率 1 のときの幅。 -->
                        <v:DropDown ItemsSource="{Binding AvailableLanguages}" DisplayMemberPath="Name"
                                    SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Left"
                                    AutomationProperties.Name="{x:Static res:Strings.Settings_Language}"
                                    Width="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=200}" />
                        <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_LanguageNote}" Style="{StaticResource Label}" Margin="0,4,0,0" />

                        <!-- 状態を選択肢の言葉で示すラジオグループ（ZasDesignSystem components.md「ラジオグループ」）。 -->
                        <v:HeadedRow Margin="0,18,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="ThemeHeading" v:LocalizedText.Text="{x:Static res:Strings.Settings_ThemeLabel}" Style="{StaticResource RadioGroupHeading}" />
                            <Border Style="{StaticResource RadioGroupFrame}">
                                <UniformGrid Rows="1" v:RadioGroup.IsGroup="True" AutomationProperties.LabeledBy="{Binding ElementName=ThemeHeading}">
                                    <RadioButton Style="{StaticResource RadioGroupItem}" v:LocalizedText.Content="{x:Static res:Strings.Settings_ThemeSystem}" r:IntentTrigger.OnClick="SettingsThemeSelected" r:IntentTrigger.Payload="System"
                                                 IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=System}" />
                                    <RadioButton Style="{StaticResource RadioGroupItem}" v:LocalizedText.Content="{x:Static res:Strings.Settings_ThemeLight}" r:IntentTrigger.OnClick="SettingsThemeSelected" r:IntentTrigger.Payload="Light"
                                                 IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Light}" />
                                    <RadioButton Style="{StaticResource RadioGroupItem}" v:LocalizedText.Content="{x:Static res:Strings.Settings_ThemeDark}" r:IntentTrigger.OnClick="SettingsThemeSelected" r:IntentTrigger.Payload="Dark"
                                                 IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Dark}" />
                                </UniformGrid>
                            </Border>
                        </v:HeadedRow>
                        <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_LanguageNote}" Style="{StaticResource Label}" Margin="0,4,0,0" />

                        <!-- UI 倍率・文字の大きさ・書体・密度は 表示 → 表示の設定 に置く（選んだ時点で反映する設定なので、［適用］の画面と分ける）。 -->
                        <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_DisplayMovedNote}" Style="{StaticResource Label}" Margin="0,18,0,0" />

                        <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_SortOrderLabel}" Style="{StaticResource FieldLabel}" Margin="0,18,0,5" />
                        <TextBox Text="{Binding SortOrder}" />

                        <CheckBox v:LocalizedText.Content="{x:Static res:Strings.Settings_AutoSaveCheckbox}" IsChecked="{Binding AutoSave}" Margin="0,18,0,0" />

                        <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_WindowHeading}" Style="{StaticResource SectionHeading}" Margin="0,22,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_WidthLabel}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding WindowWidth}"
                                         Width="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=100}" />
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_HeightLabel}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding WindowHeight}"
                                         Width="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=100}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionHeading}" Margin="0,22,0,8">
                            <Span v:LocalizedText.Text="{x:Static res:Strings.Settings_HeksaHeading}" /><Span Style="{StaticResource FieldNote}" v:LocalizedText.Text="{x:Static res:Strings.Settings_HeksaAnnotation}" />
                        </TextBlock>
                        <CheckBox v:LocalizedText.Content="{x:Static res:Strings.Settings_HeksaEnableCheckbox}" IsChecked="{Binding HeksaEnabled}" />
                        <TextBlock Style="{StaticResource Label}" Margin="0,2,0,0"
                                   v:LocalizedText.Text="{x:Static res:Strings.Settings_HeksaDescription}" />
                        <v:HeadedRow Margin="0,8,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="HeksaSourceHeading" v:LocalizedText.Text="{x:Static res:Strings.Settings_HeksaSourceLabel}" Style="{StaticResource RadioGroupHeading}" />
                            <Border Style="{StaticResource RadioGroupFrame}">
                                <UniformGrid Rows="1" v:RadioGroup.IsGroup="True" AutomationProperties.LabeledBy="{Binding ElementName=HeksaSourceHeading}">
                                    <RadioButton Style="{StaticResource RadioGroupItem}" v:LocalizedText.Content="{x:Static res:Strings.Settings_HeksaSourceFile}" r:IntentTrigger.OnClick="SettingsHeksaSourceSelected" r:IntentTrigger.Payload="File"
                                                 IsChecked="{Binding HeksaFontSource, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=File}" />
                                    <RadioButton Style="{StaticResource RadioGroupItem}" v:LocalizedText.Content="{x:Static res:Strings.Settings_HeksaSourceInstalled}" r:IntentTrigger.OnClick="SettingsHeksaSourceSelected" r:IntentTrigger.Payload="Installed"
                                                 IsChecked="{Binding HeksaFontSource, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Installed}" />
                                </UniformGrid>
                            </Border>
                        </v:HeadedRow>
                        <DockPanel Margin="0,8,0,0" Visibility="{Binding IsHeksaFromFile, Converter={StaticResource BoolVis}}">
                            <Button DockPanel.Dock="Right" v:LocalizedText.Content="{x:Static res:Strings.Settings_PickFileButton}" r:IntentTrigger.OnClick="PickHeksaFontRequested" Margin="8,0,0,0" />
                            <TextBox Text="{Binding HeksaFontPath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <!-- 言語と同じ理由で ComboBox ではなく v:DropDown。フォント名も ContentFont で描くので、
                             窓の UI フォント（Idyerin 表示ならイジェール文字）では描かれない。 -->
                        <v:DropDown ItemsSource="{Binding InstalledFontNames}" SelectedItem="{Binding HeksaFontName}" Margin="0,8,0,0"
                                    AutomationProperties.Name="{x:Static res:Strings.Settings_HeksaSourceInstalled}"
                                    Visibility="{Binding IsHeksaFromFile, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                        <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_HeksaMissingWarning}"
                                   Foreground="{StaticResource Danger}" Margin="0,8,0,0"
                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=body}"
                                   Visibility="{Binding IsFontMissing, Converter={StaticResource BoolVis}}" />
                        <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_HeksaSampleLabel}" Margin="0,8,0,0"
                                   FontFamily="{Binding PreviewFontFamily}"
                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=h2}"
                                   Visibility="{Binding HasPreviewFont, Converter={StaticResource BoolVis}}" />

                        <DockPanel Margin="0,16,0,6">
                            <Button DockPanel.Dock="Right" v:LocalizedText.Content="{x:Static res:Strings.Settings_ResetDefaultButton}" Style="{StaticResource GhostButton}"
                                    r:IntentTrigger.OnClick="SettingsReciprocalResetRequested" Margin="0" />
                            <TextBlock Style="{StaticResource SectionHeading}" Margin="0" VerticalAlignment="Center">
                                <Span v:LocalizedText.Text="{x:Static res:Strings.Settings_ReciprocalHeading}" /><Span Style="{StaticResource FieldNote}" v:LocalizedText.Text="{x:Static res:Strings.Settings_ReciprocalNote}" />
                            </TextBlock>
                        </DockPanel>
                        <TextBox Text="{Binding ReciprocalText}" AcceptsReturn="True" MinHeight="140"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem v:LocalizedText.Header="{x:Static res:Strings.Settings_TabDictionary}">
                <ScrollViewer Style="{StaticResource SettingsPage}">
                    <StackPanel>
                        <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_NoDictionaryWarning}" Foreground="{StaticResource Muted}"
                                   Visibility="{Binding HasDictionary, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                        <StackPanel Visibility="{Binding HasDictionary, Converter={StaticResource BoolVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="punctuations" /><Span Style="{StaticResource FieldNote}" v:LocalizedText.Text="{x:Static res:Strings.Settings_PunctuationsNote}" />
                            </TextBlock>
                            <TextBox Text="{Binding Punctuations}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,5">
                                <Run Text="ignoredPattern" /><Span Style="{StaticResource FieldNote}" v:LocalizedText.Text="{x:Static res:Strings.Settings_IgnoredPatternNote}" />
                            </TextBlock>
                            <TextBox Text="{Binding IgnoredPattern}" />
                            <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_DictDependentNote}"
                                       Style="{StaticResource Label}" Margin="0,10,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem v:LocalizedText.Header="{x:Static res:Strings.Settings_TabStreamWindow}">
                <ScrollViewer Style="{StaticResource SettingsPage}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Span v:LocalizedText.Text="{x:Static res:Strings.Settings_BackgroundColorLabel}" /><Span Style="{StaticResource FieldNote}" v:LocalizedText.Text="{x:Static res:Strings.Settings_BackgroundColorNote}" />
                        </TextBlock>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Width="44" Height="32" CornerRadius="6" Margin="8,0,0,0"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    Background="{Binding StreamBackground, Converter={StaticResource StringBrush}}" />
                            <TextBox Text="{Binding StreamBackground, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        </DockPanel>

                        <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_FontScaleLabel}" Style="{StaticResource FieldLabel}" Margin="0,18,0,5" />
                        <TextBox Text="{Binding StreamFontScale}" HorizontalAlignment="Left"
                                 Width="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=120}" />

                        <CheckBox v:LocalizedText.Content="{x:Static res:Strings.Settings_NotTopmostCheckbox}" IsChecked="{Binding StreamNotTopmost}" Margin="0,16,0,0" />
                        <!-- ここから下は単語ウィンドウだけの項目。単語数ウィンドウには出す中身が無い。 -->
                        <CheckBox v:LocalizedText.Content="{x:Static res:Strings.Settings_HideTranslationsCheckbox}" IsChecked="{Binding StreamHideTranslations}" />
                        <CheckBox v:LocalizedText.Content="{x:Static res:Strings.Settings_ShowContentsCheckbox}" IsChecked="{Binding StreamShowContents}" />

                        <TextBlock Style="{StaticResource Label}" Margin="0,14,0,0"
                                   v:LocalizedText.Text="{x:Static res:Strings.Settings_StreamWindowNote}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem v:LocalizedText.Header="{x:Static res:Strings.Settings_TabBrowser}">
                <ScrollViewer Style="{StaticResource SettingsPage}">
                    <StackPanel>
                        <CheckBox v:LocalizedText.Content="{x:Static res:Strings.Settings_BrowserOpenOnStartCheckbox}" IsChecked="{Binding BrowserVisible}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,5">
                            <Span v:LocalizedText.Text="{x:Static res:Strings.Settings_StartUrlLabel}" /><Span Style="{StaticResource FieldNote}" v:LocalizedText.Text="{x:Static res:Strings.Settings_StartUrlNote}" />
                        </TextBlock>
                        <TextBox Text="{Binding BrowserStartUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem v:LocalizedText.Header="{x:Static res:Strings.Settings_TabStorage}">
                <ScrollViewer Style="{StaticResource SettingsPage}">
                    <StackPanel>
                        <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_CurrentFileLabel}" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
                        <!-- 読み取り専用の TextBox にしてあるのは、選択してコピーできるようにするため。 -->
                        <TextBox Text="{Binding CurrentFilePath, Mode=OneTime}" IsReadOnly="True" TextWrapping="Wrap"
                                 Visibility="{Binding HasCurrentFile, Converter={StaticResource BoolVis}}" />
                        <TextBlock v:LocalizedText.Text="{Binding CurrentFileMissingText}" Foreground="{StaticResource Muted}"
                                   Visibility="{Binding HasCurrentFile, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                        <TextBlock Style="{StaticResource Label}" Margin="0,8,0,0"
                                   v:LocalizedText.Text="{x:Static res:Strings.Settings_CurrentFileNote}" />

                        <v:HeadedRow Margin="0,22,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="ModeHeading" v:LocalizedText.Text="{x:Static res:Strings.Settings_EditModeHeading}" Style="{StaticResource RadioGroupHeading}" />
                            <Border Style="{StaticResource RadioGroupFrame}">
                                <UniformGrid Rows="1" v:RadioGroup.IsGroup="True" AutomationProperties.LabeledBy="{Binding ElementName=ModeHeading}">
                                    <RadioButton Style="{StaticResource RadioGroupItem}" v:LocalizedText.Content="{x:Static res:Strings.Settings_ModeLocal}" r:IntentTrigger.OnClick="SettingsModeSelected" r:IntentTrigger.Payload="Local"
                                                 IsChecked="{Binding Mode, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Local}" />
                                    <RadioButton Style="{StaticResource RadioGroupItem}" Content="GitHub" r:IntentTrigger.OnClick="SettingsModeSelected" r:IntentTrigger.Payload="GitHub"
                                                 IsChecked="{Binding Mode, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=GitHub}" />
                                </UniformGrid>
                            </Border>
                        </v:HeadedRow>
                        <TextBlock Style="{StaticResource Label}" Margin="0,8,0,0"
                                   v:LocalizedText.Text="{x:Static res:Strings.Settings_GitHubModeNote}" />

                        <StackPanel Visibility="{Binding IsGitHubMode, Converter={StaticResource BoolVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,5">
                                <Span v:LocalizedText.Text="{x:Static res:Strings.Settings_RepoLabel}" /><Span Style="{StaticResource FieldNote}">（owner / repo）</Span>
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding GitHubOwner}" v:Placeholder.Text="owner" />
                                <TextBlock Grid.Column="1" Text="/" VerticalAlignment="Center" Margin="6,0" />
                                <TextBox Grid.Column="2" Text="{Binding GitHubRepo}" v:Placeholder.Text="repo" />
                            </Grid>

                            <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_BranchLabel}" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                            <TextBox Text="{Binding GitHubBranch}" HorizontalAlignment="Left" v:Placeholder.Text="main"
                                     Width="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=220}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,5">
                                <Span v:LocalizedText.Text="{x:Static res:Strings.Settings_JsonPathLabel}" /><Span Style="{StaticResource FieldNote}" v:LocalizedText.Text="{x:Static res:Strings.Settings_JsonPathNote}" />
                            </TextBlock>
                            <TextBox Text="{Binding GitHubJsonPath}" v:Placeholder.Text="{x:Static res:Strings.Settings_JsonPathPlaceholder}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,5">
                                <Span v:LocalizedText.Text="{x:Static res:Strings.Settings_ChangelogPathLabel}" /><Span Style="{StaticResource FieldNote}" v:LocalizedText.Text="{x:Static res:Strings.Settings_ChangelogPathNote}" />
                            </TextBlock>
                            <TextBox Text="{Binding GitHubChangelogPath}" v:Placeholder.Text="{x:Static res:Strings.Settings_ChangelogPathPlaceholder}" />

                            <TextBlock v:LocalizedText.Text="{x:Static res:Strings.Settings_TokenLabel}" Style="{StaticResource FieldLabel}" Margin="0,18,0,3" />
                            <TextBlock v:LocalizedText.Text="{Binding GitHubTokenHint}" Style="{StaticResource Label}" Margin="0,0,0,5" />
                            <!-- PasswordBox は Password をバインドできないため TextBox で受ける。
                                 ［適用］で保存すると設定画面ごと閉じるので、画面にトークンが残り続けることはない。
                                 保存・削除も他の項目と同じく［適用］で反映する（同じ画面に即時反映の項目を混ぜない）。 -->
                            <TextBox Text="{Binding GitHubTokenInput, UpdateSourceTrigger=PropertyChanged}"
                                     v:Placeholder.Text="{x:Static res:Strings.Settings_TokenPlaceholder}" FontFamily="Consolas" />
                            <CheckBox v:LocalizedText.Content="{x:Static res:Strings.Settings_TokenDeleteCheckbox}" IsChecked="{Binding DeleteGitHubToken}"
                                      IsEnabled="{Binding HasGitHubToken}" Margin="0,8,0,0" />
                            <TextBlock v:LocalizedText.Text="{Binding GitHubTokenStatus}" Foreground="{StaticResource Danger}" Margin="0,6,0,0"
                                       Visibility="{Binding GitHubTokenStatus, Converter={StaticResource NullVis}}" />

                            <TextBlock Style="{StaticResource Label}" Margin="0,16,0,0"
                                       v:LocalizedText.Text="{x:Static res:Strings.Settings_TokenStorageNote}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>

    <!-- 確認の層。設定ウィンドウはモーダルで本体を触れないので、本体の確認の層ではなくこの窓の中に出す。 -->
    <Border Background="{StaticResource Scrim}"
            Visibility="{Binding Confirm, Converter={StaticResource NullVis}}">
        <ContentControl Content="{Binding Confirm}" />
    </Border>
    </Grid>
</Window>
