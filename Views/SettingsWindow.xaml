<Window x:Class="ZasDictWin.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ZasDictWin.Views"
        xmlns:vm="clr-namespace:ZasDictWin.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Title, StringFormat={}ZasDict {0}}"
        Width="820" Height="760" MinWidth="560" MinHeight="440"
        Background="{StaticResource Ink}"
        FontFamily="Yu Gothic UI"
        FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=14}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize">

    <!-- 本体・独立ウィンドウ（FloatingWindow）と同じく標準の枠を持たない。CaptionHeight は 0 にし、
         ドラッグと閉じるは Header_MouseLeftButtonDown / Close_Click で自前実装する。
         設定はタブ束に混ざると誤操作しやすいので中央モーダルの見た目のまま、器だけ独立ウィンドウにしてある
         （OverlayViewModel は本来「画面内オーバーレイ」用だが、設定はストリーム配信の映り込みを気にしなくてよいため例外）。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                             CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderFill}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="16,10"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Style="{StaticResource CloseIconButton}" Click="Close_Click" ToolTip="閉じる" Margin="0" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                           FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=15}" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource FooterFill}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル" Command="{Binding CloseCommand}" />
                <Button Content="適用" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Margin="0" />
            </StackPanel>
        </Border>

        <!-- スクロール領域は窓の高さいっぱいまで使う。高さを固定すると
             文字サイズ倍率を上げたときに数行しか見えなくなる。 -->
        <TabControl Margin="24,14,24,0">
            <TabItem Header="表示・動作">
                <!-- 設定は縦にだけ流す。横スクロールを許すと折り返し幅が測定のたびに変わり、
                     上下の並びがずれて見える（横に広い内容は折り返しと末尾省略で吸収させる） -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,14,0,14">
                        <TextBlock Text="文字サイズ倍率" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FontScale}" Width="120" HorizontalAlignment="Left" />

                        <TextBlock Text="カスタム字順" Style="{StaticResource FieldLabel}" Margin="0,18,0,5" />
                        <TextBox Text="{Binding SortOrder}" FontFamily="Consolas" />

                        <CheckBox Content="編集したら自動で上書き保存する" IsChecked="{Binding AutoSave}" Margin="0,18,0,0" />

                        <TextBlock Text="ウィンドウ" Style="{StaticResource SectionHeading}" Margin="0,22,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="幅" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding WindowWidth}" Width="100" />
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="高さ" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding WindowHeight}" Width="100" />
                            </StackPanel>
                        </StackPanel>
                        <!-- 最大化には作用しない（画面いっぱいに広げる操作まで比率で縛ると使いづらいため）。
                             端をつまんで縮める・広げる操作だけを、ここで決めた幅・高さの比率に矯正する。 -->
                        <CheckBox Content="縦横比を固定する（端をつまんだリサイズを比率固定にします）"
                                  IsChecked="{Binding WindowAspectLocked}" Margin="0,10,0,0" />

                        <TextBlock Style="{StaticResource SectionHeading}" Margin="0,22,0,8">
                            <Run Text="イジェール文字フォント" /><Run Style="{StaticResource FieldNote}" Text="（Heksa）" />
                        </TextBlock>
                        <CheckBox Content="Heksa を有効にする" IsChecked="{Binding HeksaEnabled}" />
                        <TextBlock Style="{StaticResource Label}" Margin="0,2,0,0"
                                   Text="見出し語・検索欄・単語エディタの綴り欄をイジェール文字フォントで表示します（.ttf / .otf が必要です）。" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="ファイルを選択" Command="{Binding PickFontCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding HeksaFontPath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Text="フォントファイルが読み込めないため、標準フォントで表示されます。"
                                   Foreground="{StaticResource Danger}" Margin="0,8,0,0"
                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}"
                                   Visibility="{Binding IsFontMissing, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="サンプル：eaoiu heksa" Margin="0,8,0,0"
                                   FontFamily="{Binding PreviewFontFamily}"
                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=20}"
                                   Visibility="{Binding HasPreviewFont, Converter={StaticResource BoolVis}}" />

                        <DockPanel Margin="0,16,0,6">
                            <Button DockPanel.Dock="Right" Content="既定に戻す" Style="{StaticResource GhostButton}"
                                    Command="{Binding ResetReciprocalCommand}" Margin="0" />
                            <TextBlock Style="{StaticResource SectionHeading}" Margin="0" VerticalAlignment="Center">
                                <Run Text="関係の対照表" /><Run Style="{StaticResource FieldNote}" Text="（1行に 見出し=相手側）" />
                            </TextBlock>
                        </DockPanel>
                        <TextBox Text="{Binding ReciprocalText}" AcceptsReturn="True" MinHeight="140"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="辞書依存">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,14,0,14">
                        <TextBlock Text="辞書が開かれていないため編集できません。" Foreground="{StaticResource Muted}"
                                   Visibility="{Binding HasDictionary, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                        <StackPanel Visibility="{Binding HasDictionary, Converter={StaticResource BoolVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="punctuations" /><Run Style="{StaticResource FieldNote}" Text="（並べ替えで無視する文字）" />
                            </TextBlock>
                            <TextBox Text="{Binding Punctuations}" FontFamily="Consolas" />
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,5">
                                <Run Text="ignoredPattern" /><Run Style="{StaticResource FieldNote}" Text="（検索の際に無視する部分を表す正規表現）" />
                            </TextBlock>
                            <TextBox Text="{Binding IgnoredPattern}" FontFamily="Consolas" />
                            <TextBlock Text="この 2 つは辞書ファイルの zpdicOnline に書き込まれます。"
                                       Style="{StaticResource Label}" Margin="0,10,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="単語ウィンドウ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,14,0,14">
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Text="背景色" /><Run Style="{StaticResource FieldNote}" Text="（クロマキーなら #00B140 など。透過するなら Transparent）" />
                        </TextBlock>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Width="44" Height="32" CornerRadius="6" Margin="8,0,0,0"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    Background="{Binding StreamBackground, Converter={StaticResource StringBrush}}" />
                            <TextBox Text="{Binding StreamBackground, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        </DockPanel>

                        <TextBlock Text="文字サイズ倍率" Style="{StaticResource FieldLabel}" Margin="0,18,0,5" />
                        <TextBox Text="{Binding StreamFontScale}" Width="120" HorizontalAlignment="Left" />

                        <CheckBox Content="常に手前に表示する" IsChecked="{Binding StreamTopmost}" Margin="0,16,0,0" />
                        <!-- ここから下は単語ウィンドウだけの項目。単語数ウィンドウには出す中身が無い。 -->
                        <CheckBox Content="訳語を表示する" IsChecked="{Binding StreamShowTranslations}" />
                        <CheckBox Content="内容（語源・用例など）も表示する" IsChecked="{Binding StreamShowContents}" />

                        <TextBlock Style="{StaticResource Label}" Margin="0,14,0,0"
                                   Text="背景色・文字サイズ倍率・常に手前に表示するは、単語数ウィンドウにも同じものが効きます。どちらも独立したウィンドウです。OBS では［ウィンドウキャプチャ］で ZasDict 単語ウィンドウ・ZasDict 単語数ウィンドウ を選び、クロマキーフィルタを掛けてください。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ブラウザ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,14,0,14">
                        <CheckBox Content="起動時にブラウザのタブを開く" IsChecked="{Binding BrowserVisible}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,5">
                            <Run Text="開始 URL" /><Run Style="{StaticResource FieldNote}" Text="（空にすると既定の検索ページ）" />
                        </TextBlock>
                        <TextBox Text="{Binding BrowserStartUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="保存先">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,14,0,14">
                        <TextBlock Text="編集モード" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
                        <WrapPanel>
                            <ToggleButton Style="{StaticResource Chip}" Content="ローカル編集" Command="{Binding SetModeCommand}" CommandParameter="Local"
                                          IsChecked="{Binding Mode, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Local}" />
                            <ToggleButton Style="{StaticResource Chip}" Content="GitHub" Command="{Binding SetModeCommand}" CommandParameter="GitHub"
                                          IsChecked="{Binding Mode, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=GitHub}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Label}" Margin="0,8,0,0"
                                   Text="GitHubモードでは自動保存が無効になり、ヘッダーに［GitHubから読み込む］［コミット］が現れます。" />

                        <StackPanel Visibility="{Binding IsGitHubMode, Converter={StaticResource BoolVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,5">
                                <Run Text="リポジトリ" /><Run Style="{StaticResource FieldNote}" Text="（owner / repo）" />
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding GitHubOwner}" v:Placeholder.Text="owner" />
                                <TextBlock Grid.Column="1" Text="/" VerticalAlignment="Center" Margin="6,0" />
                                <TextBox Grid.Column="2" Text="{Binding GitHubRepo}" v:Placeholder.Text="repo" />
                            </Grid>

                            <TextBlock Text="ブランチ" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                            <TextBox Text="{Binding GitHubBranch}" Width="220" HorizontalAlignment="Left" v:Placeholder.Text="main" />

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,5">
                                <Run Text="辞書 JSON のパス" /><Run Style="{StaticResource FieldNote}" Text="（リポジトリ内）" />
                            </TextBlock>
                            <TextBox Text="{Binding GitHubJsonPath}" FontFamily="Consolas" v:Placeholder.Text="例: dict/lexicon.json" />

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,5">
                                <Run Text="更新履歴 CSV のパス" /><Run Style="{StaticResource FieldNote}" Text="（リポジトリ内。空欄なら読み書きしません）" />
                            </TextBlock>
                            <TextBox Text="{Binding GitHubChangelogPath}" FontFamily="Consolas" v:Placeholder.Text="例: dict/lexicon_changelog.csv" />

                            <TextBlock Text="アクセストークン" Style="{StaticResource FieldLabel}" Margin="0,18,0,3" />
                            <TextBlock Text="{Binding GitHubTokenHint}" Style="{StaticResource Label}" Margin="0,0,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- PasswordBox は Password をバインドできないため TextBox で受ける。
                                     保存すると即座に空へ戻すので、画面にトークンが残り続けることはない。 -->
                                <TextBox Grid.Column="0" Text="{Binding GitHubTokenInput, UpdateSourceTrigger=PropertyChanged}"
                                         v:Placeholder.Text="Personal Access Token（repo の Contents 読み書き権限）" FontFamily="Consolas" />
                                <Button Grid.Column="1" Content="保存" Margin="6,0,0,0" Command="{Binding SaveGitHubTokenCommand}" />
                            </Grid>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="削除" Style="{StaticResource GhostButton}"
                                        Command="{Binding DeleteGitHubTokenCommand}" Margin="0" />
                                <TextBlock Text="{Binding GitHubTokenStatus}" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Style="{StaticResource Label}" Margin="0,16,0,0"
                                       Text="トークンは settings.json ではなく別ファイルに保存されます。" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
