<Window x:Class="ZasDictWin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZasDictWin.ViewModels"
        xmlns:v="clr-namespace:ZasDictWin.Views"
        xmlns:r="clr-namespace:ZasDictWin.Root"
        xmlns:med="clr-namespace:ZasDictWin.Mediator"
        xmlns:res="clr-namespace:ZasDictWin.Resources"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle, Converter={StaticResource PlainText}}"
        Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="{StaticResource Ink}"
        BorderBrush="{StaticResource Line}" BorderThickness="1"
        FontFamily="{x:Static res:Strings.UIFont}"
        FontSize="{Binding BaseFontSize}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStyle="None" ResizeMode="CanResize">

    <Window.Resources>
        <!-- ステータス文言が変わるたびに FlashStatus（HostCommand.FlashStatus）から呼ぶ。文言自体は変わったことに気づきにくいため、
             背景を一瞬だけ光らせて変化を知らせる。 -->
        <Storyboard x:Key="StatusFlashStoryboard">
            <DoubleAnimation Storyboard.TargetName="StatusFlashBrush" Storyboard.TargetProperty="Opacity"
                              From="0.4" To="0" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- 標準の枠が無いので、上のヘッダ（アプリ名＋ボタン列）自体をつまみにする。
         CaptionHeight は 0 にし、ドラッグと最大化トグルは Header_MouseLeftButtonDown で自前実装する
         （ボタンより先にヘッダ全体をキャプションにすると、ボタンの当たり判定と衝突するため）。
         ResizeBorderThickness だけは残し、枠が無くても端をつまんでリサイズできるようにする。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                             CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <DockPanel x:Name="Root">

            <!-- 標準の枠が無いので、このヘッダ自体がウィンドウのドラッグ・つまみを兼ねる（Header_MouseLeftButtonDown）。
                 ボタンは ButtonBase 側が MouseLeftButtonDown を Handled 済みにするため、ここまでは伝播せず、
                 ボタンの無い余白だけがドラッグ領域として働く。 -->
            <Border DockPanel.Dock="Top" Background="{StaticResource HeaderFill}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1" Padding="12,7"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- アプリの顔。辞書名が長くなるので小さく据える -->
                        <Border Width="24" Height="24" CornerRadius="5" Background="{StaticResource AccentFill}"
                                Margin="0,0,9,0" VerticalAlignment="Center">
                            <TextBlock Text="Z" FontSize="13" FontWeight="Bold" Foreground="{StaticResource OnFill}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </Border>
                        <TextBlock v:LocalizedText.Text="{Binding DictionaryName}" FontWeight="SemiBold"
                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=15}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <!-- 未保存は「*」よりドット。ラベルと本文の間に記号を挟まない -->
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"
                                 ToolTip="{x:Static res:Strings.Main_UnsavedTooltip}"
                                 Visibility="{Binding IsDirty, Converter={StaticResource BoolVis}}" />
                    </StackPanel>

                    <!-- 最小化・最大化（元に戻す）・閉じる。標準の枠が無いので自前で持つ。
                         アイコンは検索欄の虫眼鏡（SearchPanel.xaml）と同じ Segoe MDL2 Assets。 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="{x:Static res:Strings.Common_Minimize}" Margin="0" />
                        <Button x:Name="MaximizeRestoreButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Style="{StaticResource IconButton}" Click="MaximizeRestore_Click" ToolTip="{x:Static res:Strings.Common_Maximize}" Margin="4,0,0,0" />
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Style="{StaticResource CloseIconButton}" Click="Close_Click" ToolTip="{x:Static res:Strings.Common_Close}" Margin="4,0,0,0" />
                    </StackPanel>

                    <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal"
TextElement.FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}">
                        <!-- 開く・新規辞書・保存・別名で保存。項目の構成と有効・無効は Mediator が組む。 -->
                        <v:MenuButton x:Name="FileMenuButton" Header="{x:Static res:Strings.Menu_File}" Items="{Binding FileMenuItems}" />
                        <!-- 統計・凡例・更新履歴・方言変換・IPA→綴りは、常設のタブ枠を食わない
                             独立ウィンドウとしてここから開く。 -->
                        <v:MenuButton x:Name="ToolsMenuButton" Header="{x:Static res:Strings.Menu_Tools}" Items="{Binding ToolsMenuItems}" />
                        <!-- GitHubモードのときだけ現れる。設定 → GitHub でリポジトリ・トークンを登録すると使える。 -->
                        <Border Width="1" Background="{StaticResource Line}" Margin="6,5"
                                Visibility="{Binding IsGitHubMode, Converter={StaticResource BoolVis}}" />
                        <Button v:LocalizedText.Content="{x:Static res:Strings.GitHub_LoadButton}" Style="{StaticResource ToolbarButton}" r:IntentTrigger.OnClick="GitHubLoadRequested" IsEnabled="{Binding CanGitHubLoad}"
                                Visibility="{Binding IsGitHubMode, Converter={StaticResource BoolVis}}"
                                ToolTip="{x:Static res:Strings.GitHub_LoadButtonTooltip}" />
                        <!-- 唯一の塗りつぶし。取り消せない外向きの操作なので、押す前に他と見分けが付くようにする。 -->
                        <Button v:LocalizedText.Content="{x:Static res:Strings.GitHub_CommitButton}" Style="{StaticResource PrimaryButton}" r:IntentTrigger.OnClick="GitHubCommitRequested" IsEnabled="{Binding CanGitHubCommit}"
                                Margin="4,0" Visibility="{Binding IsGitHubMode, Converter={StaticResource BoolVis}}"
                                ToolTip="{x:Static res:Strings.GitHub_CommitButtonTooltip}" />
                        <Border Width="1" Background="{StaticResource Line}" Margin="6,5" />
                        <Button v:LocalizedText.Content="{x:Static res:Strings.Main_NewWordButton}" Style="{StaticResource ToolbarAccentButton}" r:IntentTrigger.OnClick="NewWordRequested" IsEnabled="{Binding CanNewWord}" />
                        <Button v:LocalizedText.Content="{x:Static res:Strings.Examples_Title}" Style="{StaticResource ToolbarButton}" r:IntentTrigger.OnClick="ShowExamplesRequested" IsEnabled="{Binding CanShowExamples}"
                                ToolTip="{x:Static res:Strings.Main_ExamplesButtonTooltip}" />
                        <Button v:LocalizedText.Content="{x:Static res:Strings.Settings_Title}" Style="{StaticResource ToolbarButton}" r:IntentTrigger.OnClick="SettingsRequested" IsEnabled="{Binding CanShowSettings}" />
                        <Button x:Name="BrowserButton" v:LocalizedText.Content="{x:Static res:Strings.Browser_Title}" Style="{StaticResource ToolbarButton}"
                                r:IntentTrigger.OnClick="OpenScreenRequested" r:IntentTrigger.Payload="{x:Static med:AppCommand.ShowBrowser}"
                                IsEnabled="{Binding CanShowBrowser}" ToolTip="{x:Static res:Strings.Browser_ButtonTooltip}" />
                        <Border Width="1" Background="{StaticResource Line}" Margin="6,5" />
                        <!-- 単語ウィンドウ・単語数ウィンドウは独立した HWND で、開く／閉じるを切り替える。
                             項目名は開いているかどうかで変わる（Mediator が開閉のたびに組み直す）。 -->
                        <v:MenuButton x:Name="WindowMenuButton" Header="{x:Static res:Strings.Menu_Window}" Items="{Binding WindowMenuItems}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource FooterFill}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,1,0,0" Padding="12,5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}" Foreground="{StaticResource Muted}"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                    <Border DockPanel.Dock="Right" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="4" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock v:LocalizedText.Text="{Binding CountLabel}" Foreground="{StaticResource Muted}"
                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                    </Border>
                    <!-- フッタは 1 行固定。折り返すと状況によってフッタの高さが変わり、下端の位置が動く -->
                    <!-- Padding と負の Margin を打ち消し合わせ、光る範囲だけ広げてレイアウトへの影響を消している。
                         StatusFlashBrush は Status が変わるたびに FlashStatus が StatusFlashStoryboard で光らせる。 -->
                    <Border x:Name="StatusFlashBorder" CornerRadius="4" Padding="6,2" Margin="-6,-2,-6,-2">
                        <Border.Background>
                            <SolidColorBrush x:Name="StatusFlashBrush" Color="{StaticResource AccentColor}" Opacity="0" />
                        </Border.Background>
                        <TextBlock v:LocalizedText.Text="{Binding Status}" Foreground="{StaticResource Muted}"
                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </Border>
                </DockPanel>
            </Border>

            <!-- 画面の割り付け。枠（タブ束）と、それを 2 つに割った境目の入れ子をそのまま描く。
                 上下左右の決め打ちは持たず、枠の四隅を引いて割ったり結合したりする（Blender と同じ操作）。
                 検索もブラウザも他のオーバーレイと同じ 1 枚のタブで、どの枠にも置ける。
                 描き分けは App.xaml の DataTemplate（DockSplit / DockLeaf）が持つ。 -->
            <ContentControl Content="{Binding Layout.Root}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </DockPanel>

        <!-- 確認ダイアログの層。MessageBox は別 HWND になり OBS のウィンドウキャプチャに映らない
             ため、ここに描く。枠に並べた画面を閉じずに上へ重ねられるよう層を分けてある。 -->
        <Border Background="{StaticResource Scrim}"
                Visibility="{Binding ModalOverlay, Converter={StaticResource NullVis}}">
            <ContentControl Content="{Binding ModalOverlay}" />
        </Border>
    </Grid>
</Window>
