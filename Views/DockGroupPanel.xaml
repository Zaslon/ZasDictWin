<UserControl x:Class="ZasDictWin.Views.DockGroupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ZasDictWin.Views"
             xmlns:vm="clr-namespace:ZasDictWin.ViewModels">

    <!-- 枠ひとつぶん。DataContext は DockLeaf。
         タブを掴んでいる間はこの枠そのものがドロップ先で、カーソルが乗ると全体が着色される。
         四隅のつまみは Blender と同じ役目で、内へ引けば分割、隣へ引けば結合。 -->
    <Grid x:Name="Host">
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <DockPanel>
                <!-- タブ列。1 枚でも出す（掴んで別の枠へ運ぶ取っ手を兼ねるため）。
                     まだタブの無い枠には並べるものが無いので出さない。 -->
                <Border DockPanel.Dock="Top" Background="{StaticResource HeaderFill}"
                        BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6,5"
                        Visibility="{Binding HasItems, Converter={StaticResource BoolVis}}">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OverlayViewModel}">
                                <!-- 据え置きのタブ（検索・単語詳細）は運べるが閉じられない。 -->
                                <Border MouseDown="Tab_MouseDown" Style="{StaticResource DockTab}"
                                        v:OverlayDrag.IsGrip="True">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 見出しは 1 行。長い題は末尾を省略してタブの幅を暴れさせない -->
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="150"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                                        <Button Content="✕" Style="{StaticResource IconButton}" Width="20" Height="20"
                                                Margin="6,0,0,0" Command="{Binding CloseCommand}"
                                                Visibility="{Binding IsPinned, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- 中身は全部そのまま置いておき、表に出ているタブだけ見せる。切り替えのたびに
                     作り直すと、ブラウザ（WebView2）が開き直しになって見ていたページが飛ぶ。 -->
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="{Binding IsActive, Converter={StaticResource BoolVis}}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 分割で作ったまま、まだタブの無い枠。運び込むか、ここで畳むかのどちらか。 -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
            <TextBlock Text="タブをここへ運べます" Style="{StaticResource AreaHintLabel}" />
            <Button Content="枠を閉じる" Click="CloseArea_Click" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>

        <!-- 角を内へ引いている間の下見。これから新しくできる側だけを塗る。 -->
        <Border Style="{StaticResource DropHighlight}"
                Visibility="{Binding Preview, Converter={StaticResource NullVis}}">
            <Border.Margin>
                <MultiBinding Converter="{StaticResource SplitMargin}">
                    <Binding ElementName="Host" Path="ActualWidth" />
                    <Binding ElementName="Host" Path="ActualHeight" />
                    <Binding Path="Preview" />
                </MultiBinding>
            </Border.Margin>
        </Border>

        <!-- カーソルが乗っている枠の着色。当たり判定は下の枠が持つので、ここは素通りさせる。 -->
        <Border Style="{StaticResource DropHighlight}"
                Visibility="{Binding IsDropTarget, Converter={StaticResource BoolVis}}" />

        <!-- 結合で消える側。タブは残る枠へ移るので、消えるのは枠だけ。 -->
        <Border Style="{StaticResource JoinHighlight}"
                Visibility="{Binding IsJoinTarget, Converter={StaticResource BoolVis}}" />

        <!-- 四隅のつまみ。内へ引けば分割、隣の枠へ引けば結合（どちらも下見が出る）。 -->
        <Border Style="{StaticResource AreaCorner}" v:AreaDrag.IsGrip="True"
                HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Border Style="{StaticResource AreaCorner}" v:AreaDrag.IsGrip="True"
                HorizontalAlignment="Right" VerticalAlignment="Top" />
        <Border Style="{StaticResource AreaCorner}" v:AreaDrag.IsGrip="True"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" />
        <Border Style="{StaticResource AreaCorner}" v:AreaDrag.IsGrip="True"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" />
    </Grid>
</UserControl>
