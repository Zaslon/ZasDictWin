<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ダークモードの配色。値は ZasDesignSystem の local-design-system/tokens.md「色の役割」のダークの値を写す。
         キー名は参照側（オーバーレイ含む）との契約なので、調整は tokens.md を直してから値だけを写し直す。
         コメントの color-* が対応するトークン。影系 Effect は一切使わない方針
         （ビットマップ化されると文字がにじみ、OBS のウィンドウキャプチャ画質を落とすため）。 -->
    <Color x:Key="InkColor">#181818</Color>          <!-- color-background -->
    <Color x:Key="PanelColor">#212121</Color>        <!-- color-surface -->
    <Color x:Key="RaisedColor">#181818</Color>       <!-- color-button -->
    <Color x:Key="LineColor">#767676</Color>         <!-- color-border -->
    <Color x:Key="AccentColor">#B3B0FF</Color>       <!-- color-accent -->
    <Color x:Key="AccentFillColor">#6A56D7</Color>   <!-- color-accent-fill -->
    <Color x:Key="DangerColor">#FF9696</Color>       <!-- color-error-text -->
    <Color x:Key="ChromeColor">#212121</Color>       <!-- color-statusbar-background -->
    <!-- ステータスバーを Semantic ごとに強調する色（color-statusbar-*）。MainWindow.FlashStatus が引く。 -->
    <Color x:Key="StatusInfoColor">#380C91</Color>
    <Color x:Key="StatusSuccessColor">#08351F</Color>
    <Color x:Key="StatusWarningColor">#604B00</Color>
    <Color x:Key="StatusErrorColor">#850000</Color>

    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <!-- color-border は下の面に重なるもの（窓・オーバーレイ・ポップアップ・ツールチップ）の外周と、
         操作部品の境界に限る。並べて置いた枠・ヘッダ・フッタの境目は Divider（color-divider）で引く。
         境目に 3:1 の線を引くと、線が文字より目立つため。 -->
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <!-- color-divider -->
    <SolidColorBrush x:Key="Divider" Color="#4D4D4D" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Text" Color="#FFFFFF" />                <!-- color-text -->
    <SolidColorBrush x:Key="Muted" Color="#B3B3B3" />               <!-- color-text-secondary -->
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Scrim" Color="#B3000000" />             <!-- color-overlay（black 70%） -->
    <SolidColorBrush x:Key="OnFill" Color="#FFFFFF" />              <!-- color-on-accent-fill / color-on-destructive -->

    <SolidColorBrush x:Key="Field" Color="#181818" />               <!-- color-input-background -->
    <SolidColorBrush x:Key="InputBorder" Color="#7F7F7F" />         <!-- color-input-border -->
    <!-- 行・タブ・枠の無いボタンのホバー。ダークは DADS に定義が無いため、段階 2 の面（bg-dark-2）を使う -->
    <SolidColorBrush x:Key="RowHover" Color="#2A2A2A" />
    <SolidColorBrush x:Key="AccentDim" Color="#380C91" />           <!-- color-selected-background -->
    <!-- color-drop-target。下の中身を透かして「どの枠に入るか」を見せるため半透明で重ねる -->
    <SolidColorBrush x:Key="DropFill" Color="#4321A3" Opacity="0.6" />
    <!-- 結合で消える側の面。タブは残る枠へ移るが、枠そのものは無くなるので失敗の強調色で塗り分ける -->
    <SolidColorBrush x:Key="JoinFill" Color="#850000" Opacity="0.6" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#999999" />          <!-- color-scrollbar-thumb -->
    <SolidColorBrush x:Key="ThumbHover" Color="#B3B3B3" />
    <SolidColorBrush x:Key="ScrollTrack" Color="#333333" />         <!-- color-scrollbar-track -->

    <!-- 枠のボタン（color-button-*） -->
    <SolidColorBrush x:Key="ButtonText" Color="#B3B0FF" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#B3B0FF" />
    <SolidColorBrush x:Key="ButtonHover" Color="#4321A3" />
    <SolidColorBrush x:Key="ButtonActive" Color="#4A2DAD" />
    <SolidColorBrush x:Key="ButtonTextHover" Color="#C9C9FF" />
    <SolidColorBrush x:Key="ButtonTextActive" Color="#E0E1FF" />

    <!-- 塗りのボタン。面はすべて単色。グラデーションは縁に明暗の段が出て、隣り合う面との境目が二重に見える。 -->
    <SolidColorBrush x:Key="AccentFill" Color="{StaticResource AccentFillColor}" />
    <SolidColorBrush x:Key="AccentFillHover" Color="#573DBE" />     <!-- color-accent-fill-hover -->
    <SolidColorBrush x:Key="AccentFillActive" Color="#4A2DAD" />    <!-- color-accent-fill-active -->
    <SolidColorBrush x:Key="DangerFill" Color="#EC0000" />          <!-- color-destructive -->
    <SolidColorBrush x:Key="DangerFillHover" Color="#A90000" />     <!-- color-destructive-hover -->
    <SolidColorBrush x:Key="DangerFillActive" Color="#850000" />    <!-- color-destructive-active -->

    <!-- 無効状態 -->
    <SolidColorBrush x:Key="Disabled" Color="#4D4D4D" />            <!-- color-disabled -->
    <SolidColorBrush x:Key="OnDisabled" Color="#B3B3B3" />          <!-- color-on-disabled -->
    <SolidColorBrush x:Key="DisabledText" Color="#666666" />        <!-- color-disabled-text -->

    <SolidColorBrush x:Key="HeaderFill" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="FooterFill" Color="{StaticResource ChromeColor}" />
    <SolidColorBrush x:Key="StatusText" Color="#FFFFFF" />          <!-- color-statusbar-text -->

    <!-- ノティフィケーションアイコン（color-notification-*） -->
    <SolidColorBrush x:Key="NotifyInfo" Color="#B3B3B3" />
    <SolidColorBrush x:Key="NotifySuccess" Color="#71C598" />
    <SolidColorBrush x:Key="NotifyWarning" Color="#FFD43D" />
    <SolidColorBrush x:Key="NotifyError" Color="#FF9696" />

    <!-- フォーカス表示（color-focus-*）。テーマによらず同じ値 -->
    <SolidColorBrush x:Key="FocusInner" Color="#FFD43D" />
    <SolidColorBrush x:Key="FocusOuter" Color="#000000" />
</ResourceDictionary>
