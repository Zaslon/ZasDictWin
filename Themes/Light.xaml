<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ライトモードの配色。Dark.xaml と同じキーを持ち、値は ZasDesignSystem の tokens.md のライトの値を写す
         （キーとトークンの対応は Dark.xaml のコメントを参照）。 -->
    <Color x:Key="InkColor">#FFFFFF</Color>
    <Color x:Key="PanelColor">#F2F2F2</Color>
    <Color x:Key="RaisedColor">#FFFFFF</Color>
    <Color x:Key="LineColor">#7F7F7F</Color>
    <Color x:Key="AccentColor">#573DBE</Color>
    <Color x:Key="AccentFillColor">#4321A3</Color>
    <Color x:Key="DangerColor">#CE0000</Color>
    <Color x:Key="ChromeColor">#F2F2F2</Color>
    <Color x:Key="StatusInfoColor">#E0E1FF</Color>
    <Color x:Key="StatusSuccessColor">#C2E5D1</Color>
    <Color x:Key="StatusWarningColor">#FFF0B3</Color>
    <Color x:Key="StatusErrorColor">#FFDADA</Color>

    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <!-- color-divider。使い分けは Dark.xaml の Line の注記を参照 -->
    <SolidColorBrush x:Key="Divider" Color="#CCCCCC" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Text" Color="#000000" />
    <SolidColorBrush x:Key="Muted" Color="#666666" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Scrim" Color="#80000000" />
    <SolidColorBrush x:Key="OnFill" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Field" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorder" Color="#767676" />
    <!-- 面（PanelColor）が DADS のホバー色 gray-50 と同じ値なので、一段濃い gray-100 にしないと面の上で見えない -->
    <SolidColorBrush x:Key="RowHover" Color="#E6E6E6" />
    <SolidColorBrush x:Key="AccentDim" Color="#E0E1FF" />
    <SolidColorBrush x:Key="DropFill" Color="#C9C9FF" Opacity="0.6" />
    <SolidColorBrush x:Key="JoinFill" Color="#FFDADA" Opacity="0.7" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#767676" />
    <SolidColorBrush x:Key="ThumbHover" Color="#4D4D4D" />
    <SolidColorBrush x:Key="ScrollTrack" Color="#E6E6E6" />

    <SolidColorBrush x:Key="ButtonText" Color="#4321A3" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#4321A3" />
    <SolidColorBrush x:Key="ButtonHover" Color="#C9C9FF" />
    <SolidColorBrush x:Key="ButtonActive" Color="#B3B0FF" />
    <SolidColorBrush x:Key="ButtonTextHover" Color="#380C91" />
    <SolidColorBrush x:Key="ButtonTextActive" Color="#1A024E" />

    <SolidColorBrush x:Key="AccentFill" Color="{StaticResource AccentFillColor}" />
    <SolidColorBrush x:Key="AccentFillHover" Color="#380C91" />
    <SolidColorBrush x:Key="AccentFillActive" Color="#1A024E" />
    <SolidColorBrush x:Key="DangerFill" Color="#CE0000" />
    <SolidColorBrush x:Key="DangerFillHover" Color="#A90000" />
    <SolidColorBrush x:Key="DangerFillActive" Color="#620000" />

    <SolidColorBrush x:Key="Disabled" Color="#B3B3B3" />
    <SolidColorBrush x:Key="OnDisabled" Color="#F2F2F2" />
    <SolidColorBrush x:Key="DisabledText" Color="#B3B3B3" />

    <SolidColorBrush x:Key="HeaderFill" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="FooterFill" Color="{StaticResource ChromeColor}" />
    <SolidColorBrush x:Key="StatusText" Color="#000000" />

    <SolidColorBrush x:Key="NotifyInfo" Color="#666666" />
    <SolidColorBrush x:Key="NotifySuccess" Color="#115A36" />
    <SolidColorBrush x:Key="NotifyWarning" Color="#806300" />
    <SolidColorBrush x:Key="NotifyError" Color="#CE0000" />
</ResourceDictionary>
