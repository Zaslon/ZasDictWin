<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ライトモードの配色。Theme.xaml の配色トークンと同じキーを持ち、起動時に ThemePalette が
         Theme.xaml の値をこれで差し替える（キーの意味は Theme.xaml 側の説明を参照）。
         暗い面から順に Ink < Chrome < Panel < Raised の明暗は、ダークと逆向きにして同じ階層感を保つ。 -->
    <Color x:Key="InkColor">#ECECEC</Color>
    <Color x:Key="PanelColor">#F8F8F8</Color>
    <Color x:Key="RaisedColor">#FFFFFF</Color>
    <Color x:Key="LineColor">#D2D2D2</Color>
    <!-- 文字・枠用のアクセントは明るい面で読める濃さ、塗り用は白文字が沈まない濃さにする -->
    <Color x:Key="AccentColor">#5B45D6</Color>
    <Color x:Key="AccentFillColor">#6550E6</Color>
    <Color x:Key="DangerColor">#C9252B</Color>
    <Color x:Key="ChromeColor">#E2E2E2</Color>

    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Text" Color="#1C1C1C" />
    <SolidColorBrush x:Key="Muted" Color="#5E5E5E" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Scrim" Color="#66000000" />
    <SolidColorBrush x:Key="OnFill" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Field" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RowHover" Color="#E6E6E6" />
    <SolidColorBrush x:Key="AccentDim" Color="#E3DEFB" />
    <SolidColorBrush x:Key="DropFill" Color="{StaticResource AccentColor}" Opacity="0.18" />
    <SolidColorBrush x:Key="JoinFill" Color="{StaticResource DangerColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#C4C4C4" />
    <SolidColorBrush x:Key="ThumbHover" Color="#A6A6A6" />
    <SolidColorBrush x:Key="HoverVeil" Color="#000000" />
    <SolidColorBrush x:Key="PressedVeil" Color="#000000" />
    <SolidColorBrush x:Key="CardBorder" Color="#C2C2C2" />
    <SolidColorBrush x:Key="PopupBorder" Color="#B8B8B8" />

    <SolidColorBrush x:Key="AccentFill" Color="{StaticResource AccentFillColor}" />
    <SolidColorBrush x:Key="DangerFill" Color="#D33036" />
    <SolidColorBrush x:Key="HeaderFill" Color="{StaticResource ChromeColor}" />
    <SolidColorBrush x:Key="FooterFill" Color="{StaticResource ChromeColor}" />
</ResourceDictionary>
