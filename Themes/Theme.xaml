<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:ZasDictWin.Views"
                    xmlns:vm="clr-namespace:ZasDictWin.ViewModels"
                    xmlns:med="clr-namespace:ZasDictWin.Mediator"
                    xmlns:res="clr-namespace:ZasDictWin.Resources">

    <v:BoolToVisibilityConverter x:Key="BoolVis" />
    <v:EnumMatchConverter x:Key="EnumMatch" />
    <v:NullToVisibilityConverter x:Key="NullVis" />
    <v:CountToVisibilityConverter x:Key="CountVis" />
    <v:StringToBrushConverter x:Key="StringBrush" />
    <v:ScaleFontSizeConverter x:Key="ScaleFont" />
    <v:ScaleThicknessConverter x:Key="ScaleThickness" />
    <v:ScaleLineHeightConverter x:Key="ScaleLineHeight" />
    <v:ScaleMinSizeConverter x:Key="ScaleMinSize" />
    <v:SplitMarginConverter x:Key="SplitMargin" />
    <v:PlainTextConverter x:Key="PlainText" />

    <!-- 配色は Themes/Dark.xaml（既定）と Themes/Light.xaml に分けてあり、App.xaml がこの辞書より先に読み込む。
         起動時に ThemePalette がどちらかに差し替えるので、ここに色の値を書かない。 -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- キーボードで選んだ要素のフォーカス表示（ZasDesignSystem implementation/wpf.md「フォーカス表示」）。
         color-accent、太さ 2 の枠を要素から 2 離して描く。FocusVisualStyle は Tab や矢印キーで移ったときだけ描かれ、
         クリックで選んだときは出ない。テンプレートの IsFocused / IsKeyboardFocused のトリガーで描くと、
         クリックでも出てしまうので、操作要素の Style ではこれを FocusVisualStyle に指定する。
         AdornerLayer に描かれるので、要素の寸法は変わらない。 -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="10"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ノティフィケーションアイコン（ZasDesignSystem の icons/wpf/Icons.xaml から写した DADS コード例の図形。
         MIT License、licenses/LICENSE-dads-code.txt）。24×24 の座標で、色は置く側の Fill で付ける。 -->
    <PathGeometry x:Key="Icon_info" FillRule="EvenOdd" Figures="M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20ZM12 7a1 1 0 1 0 0 2a1 1 0 1 0 0-2ZM11 11h2v6h-2Z" />
    <PathGeometry x:Key="Icon_success" FillRule="EvenOdd" Figures="M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20ZM17.6 9.6l-7 7-4.3-4.3L7.7 11l2.9 2.9 5.7-5.6 1.3 1.4Z" />
    <PathGeometry x:Key="Icon_warning" FillRule="EvenOdd" Figures="M1 21 12 2l11 19H1ZM13 15h-2v-5h2v5ZM12 16a1 1 0 1 0 0 2a1 1 0 1 0 0-2Z" />
    <PathGeometry x:Key="Icon_error" FillRule="EvenOdd" Figures="M8.25 21 3 15.75v-7.5L8.25 3h7.5L21 8.25v7.5L15.75 21h-7.5ZM12 13.4l-2.85 2.85-1.4-1.4L10.6 12 7.75 9.15l1.4-1.4L12 10.6l2.85-2.85 1.4 1.4L13.4 12l2.85 2.85-1.4 1.4L12 13.4Z" />

    <!-- 明示的な Style を指定すると既定（暗黙の）TextBlock スタイルが打ち消されるため、折り返しは
         ここで再度宣言する必要がある。省略すると長い案内文が幅を超えて横にはみ出し、オーバーレイ側で
         横スクロールを封じているために末尾が切れて読めなくなる。 -->
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=body}" />
        <!-- 複数行にわたる案内文なので text-body の行高を当てる。BlockLineHeight でないと、書体の行の高さより小さくできない。 -->
        <Setter Property="LineHeight" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleLineHeight}, ConverterParameter=body}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- 入力欄・チェックボックスに付く項目名。既定の本文が 14 なので、Label（案内文）の字送りだと
         値より小さく薄くなり、名前のほうが埋もれる。本文と同じ大きさ＋通常の文字色で前に出す。 -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <!-- 項目名に添える補足（「（カンマ区切り）」など）。FieldLabel の中に Span で混ぜて使い、
         名前だけが太く明るく残るようにする。TargetType が Span なのは、UI 文字列を流す側が
         v:LocalizedText.Text を付けた Span になるため。付ける先は必ず Span にすること。
         WPF の Style は TargetType と要素の型が一致していないと弾かれるので、派生である Run に
         これを付けると、その画面を開いた瞬間に XamlParseException で落ちる。 -->
    <Style x:Key="FieldNote" TargetType="Span">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- 節の見出し。TextBlock には Border プロパティがなく、左ラインを背景で描く手も
         SpreadMethod="None" が WPF に存在しないため使えない。字ヅラと色だけで本文との階層を
         分け、かたまりの区切りはカード枠に担わせる。 -->
    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=h3}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- 表示するものがないことを伝える案内 -->
    <Style x:Key="EmptyState" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=body}" />
        <Setter Property="LineHeight" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleLineHeight}, ConverterParameter=body}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <!-- Stretch にしておかないと要素が内容幅で自動サイズになり、折り返さずにはみ出す -->
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="24" />
    </Style>

    <!-- ボタン。既定は枠のボタン（tokens.md「ボタン・入力欄」の color-button-*）。
         ホバー・押下・無効の色は Style.Triggers で替える。テンプレートのトリガーで替えると、
         派生スタイル（Primary / Danger / 枠なし）の Setter より優先されてしまい、塗りのボタンまで
         枠のボタンのホバー色になる。派生スタイルは自分の Style.Triggers で上書きする
         （同じ条件のトリガーは後に書いたものが勝つので、BasedOn の派生側が勝つ）。 -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ButtonText}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ButtonHover}" />
                <Setter Property="Foreground" Value="{StaticResource ButtonTextHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource ButtonTextHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ButtonActive}" />
                <Setter Property="Foreground" Value="{StaticResource ButtonTextActive}" />
                <Setter Property="BorderBrush" Value="{StaticResource ButtonTextActive}" />
            </Trigger>
            <!-- 無効は半透明にせず color-disabled で塗る。半透明だと下の面の色が透けて、塗りのボタンが
                 押せそうな色のまま残る。 -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Disabled}" />
                <Setter Property="Foreground" Value="{StaticResource OnDisabled}" />
                <Setter Property="BorderBrush" Value="{StaticResource Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentFill}" />
        <Setter Property="Foreground" Value="{StaticResource OnFill}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentFill}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentFillHover}" />
                <Setter Property="Foreground" Value="{StaticResource OnFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentFillHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentFillActive}" />
                <Setter Property="Foreground" Value="{StaticResource OnFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentFillActive}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Disabled}" />
                <Setter Property="Foreground" Value="{StaticResource OnDisabled}" />
                <Setter Property="BorderBrush" Value="{StaticResource Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 警告ボタン（color-destructive-*）。削除など、データを失う操作に使う。 -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerFill}" />
        <Setter Property="Foreground" Value="{StaticResource OnFill}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerFill}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerFillHover}" />
                <Setter Property="Foreground" Value="{StaticResource OnFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerFillHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerFillActive}" />
                <Setter Property="Foreground" Value="{StaticResource OnFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerFillActive}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Disabled}" />
                <Setter Property="Foreground" Value="{StaticResource OnDisabled}" />
                <Setter Property="BorderBrush" Value="{StaticResource Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 枠の無いボタン（tokens.md の「テキストのボタン」）。面はホバーのときだけ出す。
         無効のときは面を塗らず、文字だけ color-disabled-text にする。 -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ButtonText}" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="MinHeight" Value="28" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RowHover}" />
                <Setter Property="Foreground" Value="{StaticResource ButtonTextHover}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource RowHover}" />
                <Setter Property="Foreground" Value="{StaticResource ButtonTextActive}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ヘッダのメニュー列。項目ごとに枠と面を持たせると、10 個近く並んだときに囲みの線が
         文字より目立って項目名を拾えなくなるため、面は hover のときだけ出す。
         押せることは Hand カーソルと hover の面が示す。文字は本文色にして、枠のボタンと見分ける。 -->
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="MinHeight" Value="32" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- メニュー列のなかで最もよく使う項目（単語の追加）。面で塗ると囲みの線が出て、
         枠なしに揃えたメニュー列から浮くので、文字色だけをアクセントにして段を付ける。 -->
    <Style x:Key="ToolbarAccentButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 戻る／進むなど、記号一文字を並べるツールバー用。文字色だけの変化だと当たり判定の広さが
         見えないので、hover では薄い面も出して押せる範囲を示す。
         記号だけで文字を持たないので、使う側で AutomationProperties.Name に読み上げ用の名前を付けること。 -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=body}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- タブの閉じるボタン。操作範囲は size-target-pointer（28）を下回らせない。 -->
    <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="Content" Value="&#xE711;" />
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
    </Style>

    <!-- ウィンドウを閉じるボタン。hover で他の IconButton と違い赤面にして、押すと閉じる操作だと
         強調する（最小化・最大化と誤って隣接クリックしないための視覚差） -->
    <Style x:Key="CloseIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerFill}" />
                <Setter Property="Foreground" Value="{StaticResource OnFill}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerFillActive}" />
                <Setter Property="Foreground" Value="{StaticResource OnFill}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 入力欄。v:Placeholder.Text を付けると、空のときだけ薄い案内文字が出る。
         フォーカス表示は FocusVisualStyle ではなく枠で示す（ZasDesignSystem implementation/wpf.md「フォーカス表示」の入力欄の例外）。
         入力先を示すため、クリックで選んだときも同じにする。 -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- 単一行の入力欄は中身を縦中央に置く。高さを明示した欄でも余白が上下に割れるようにするため。
             複数行の入力欄は下の Trigger で上寄せへ戻す。中身が箱の中央に浮いて見えてしまうため。
             フォールバックフォントが上端で欠けるのは、ここではなくフォント側で防ぐ（ViewModels/Mvvm.cs の
             HeadwordFontState.FieldFamily）。WPF の行の高さは主フォントの LineSpacing だけで決まり、
             フォールバック先が背高でも広がらないため、縦の寄せや余白では逃がしきれない。 -->
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- 入力欄の中身は UI 文字列ではなく辞書データや設定値なので、表示言語のフォントは継がせない。
             継ぐと Idyerin 表示で主フォントが Heksa になり、日本語が字を持たないフォントから落ちて
             行の高さが足りなくなる（欄ごとの指定は個別に上書きする。綴り欄の Heksa、英数字だけの欄の Consolas）。
             Consolas は色コード・トークンのように仕様上日本語が入りえない欄に限る。日本語の字を持たず
             行も低いので、パスや正規表現など日本語が混ざりうる欄に当てると同じ理由で上端が欠ける。 -->
        <Setter Property="FontFamily" Value="{x:Static res:Strings.ContentFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                    <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- ここに Margin="{TemplateBinding Padding}" を足さないこと。TextBox は
                                 中身を Padding のぶん自分で内側へ寄せるため、余白が二重に効いて
                                 欄が縦に膨らみ、打った字だけが下の案内文字より右へずれる。 -->
                            <ScrollViewer x:Name="PART_ContentHost" />
                            <!-- 案内文字は 1 行。NoWrap を書かないと暗黙の TextBlock スタイル（Wrap）が効いて
                                 折り返してしまい、TextTrimming が働かない。
                                 TextBlock は上の TextBox と違って自分では寄せないので、Margin で同じだけ寄せる。
                                 入力欄の中身と違って必ず UI 文字列なので、入力欄側のフォント
                                 （URL 欄の en、綴り欄の Heksa、英数字だけの欄の Consolas）は継承させない。 -->
                            <TextBlock x:Name="ph"
                                       v:LocalizedText.Text="{Binding Path=(v:Placeholder.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=UiFont}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       Foreground="{StaticResource Muted}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <!-- フォーカス中・エラー中の太さ 2 の枠。bd の枠を 1 から 2 に太くすると中の文字が 1 ずれるので、
                         太くせずに同じ角丸の枠を上に重ねる（重ねた枠の内側 1 は余白に掛かるだけで、文字は動かない）。 -->
                    <Border x:Name="ring" CornerRadius="8" BorderThickness="2" IsHitTestVisible="False"
                            BorderBrush="{StaticResource Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- エラーはフォーカスより後に書く。両方が成り立つときは後のトリガーが勝ち、枠はエラーの色のまま太さだけ 2 になる。 -->
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Danger}" />
                            <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Disabled}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Disabled}" />
                            <Setter Property="Foreground" Value="{StaticResource OnDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 選択してコピーできる本文（v:SelectableText / v:SelectableRichText）。中身は読み取り専用の
         TextBox なので、入力欄に見えないよう枠・面・余白を落として素の文字に寄せる。
         IsTabStop を落としてあるのは、本文が Tab の巡回に割り込むと操作の順番が読めなくなるから。
         右クリックのメニューは SelectableText.cs 側で畳んである（コピーは選んで Ctrl+C）。 -->
    <Style x:Key="SelectableTextBase" TargetType="Control">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="{x:Type v:SelectableText}" BasedOn="{StaticResource SelectableTextBase}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsUndoEnabled" Value="False" />
        <!-- 読み取り専用でも Enter を弾かせないため。ここを既定（false）のままにすると、
             改行を含む本文が 1 行に潰れて表示される。 -->
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:SelectableText}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                                  Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type v:SelectableRichText}" BasedOn="{StaticResource SelectableTextBase}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsUndoEnabled" Value="False" />
        <Setter Property="IsDocumentEnabled" Value="False" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:SelectableRichText}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                                  Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 既定の CheckBox は明るい灰の箱で、ダークテーマに馴染まないため作り直す。
         チェックは Path で描く（記号フォントの有無に依存しない）。 -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- 横並びの StackPanel だと ContentPresenter に無限の幅が渡ってしまい、
                         文字サイズ倍率を上げた長い項目名が折り返さずウィンドウの外へはみ出す。
                         Grid で右列の幅を有限に区切ることで、既定の TextBlock スタイル（Wrap）が効くようにする。
                         箱の大きさ自体も文字サイズ倍率で伸ばさないと、拡大時に文字だけ大きくなって
                         チェック済みかどうかが見分けにくい豆粒のまま残る。 -->
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Grid.Column="0" CornerRadius="4"
                                Width="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=18}"
                                Height="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=18}"
                                Background="{StaticResource Field}" BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="check" Data="M 3.4,8.6 L 7.0,12.0 L 14.2,4.6"
                                  Stroke="{StaticResource OnFill}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Margin="4" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource AccentFill}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentFill}" />
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Disabled}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Disabled}" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ツールチップは既定が白背景なので、ダークテーマに合わせたカードに差し替える。
         別の視覚ツリーなので窓の根に掛けた UI 倍率が届かず、ここで同じ倍率を掛ける。 -->
    <Style TargetType="ToolTip">
        <Setter Property="LayoutTransform" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=UiScaleTransform}" />
        <Setter Property="FontFamily" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=UiFont}" />
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=small}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HasDropShadow" Value="False" />
        <!-- ツールチップの中身はこのアプリでは常に UI 文字列（Resources/Strings.*.resx）なので、
             [en] を解けるよう一括でここに通す。文字列以外を ToolTip に入れると
             ToString() が出るだけになるため、そうしたくなったら ContentTemplateSelector に替えること。 -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock v:LocalizedText.Text="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 一覧。角丸の行として hover / 選択を出す。
         選択行は左の細いバーで示す（背景だけより走査しやすい）。 -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="mark" Grid.Column="0" CornerRadius="2" Margin="0,3,7,3"
                                    Background="{StaticResource AccentFill}" Opacity="0" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDim}" />
                            <Setter TargetName="mark" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- タブとページを一枚の面としてつなげる。選択タブの塗り・枠をページ側と揃え、
         タブの下端 1px をページの上枠に重ねて継ぎ目を消す。ページ側を塗らずにタブだけを塗ると、
         タブと中身が別の面に見えて切り離される。 -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,8,8,8" Padding="{TemplateBinding Padding}">
                            <!-- 名前は PART_SelectedContentHost 固定。TabControl はこの名前で
                                 ページの差し替え先を探す。 -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                        <!-- ヘッダーを前面に置き、選択タブがページの上枠を隠せるようにする -->
                        <TabPanel Grid.Row="0" Panel.ZIndex="1" IsItemsHost="True"
                                  KeyboardNavigation.TabIndex="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 文字色と太さは TabItem 本体ではなくヘッダーの Border（bd）に載せること。TabItem の
         Content（＝タブページの中身）は論理ツリー上 TabItem の子なので、TabControl の
         表示領域に描かれていても TabItem からの継承が届く。Foreground や FontWeight を
         TabItem に置くと、選択中のページの中身まで丸ごとその色・太さになる。
         とくに FlowDocument（凡例タブ）は自前で FontWeight を持たないため全文が太字になる。 -->
    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <!-- 下の -1 はページ枠との重ね代。0 に戻すと選択タブとページの間に枠線が残って分断される -->
        <Setter Property="Margin" Value="0,0,2,-1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1,1,1,0" CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{StaticResource Muted}">
                            <!-- ContentSource="Header" は必須。省略すると ContentPresenter が TabItem.Content、
                                 つまりページ本体をヘッダー枠の中に描いてしまう。TabPanel は子を無限サイズで
                                 測るため、内側の ScrollViewer に高さが渡らずスクロールできなくなり、
                                 FlowDocument は無限幅で Arrange されて WPF 側で回復不能なクラッシュ
                                 （PtsHost の FailFast）にまで至る。既定テンプレートと同じ形に固定する。 -->
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <!-- 選択を示すアクセントは上辺に置く。下辺に置くとページとの境界線に見える。
                             左右の余白は角丸をまたがないための逃げ。 -->
                        <Border x:Name="ul" Height="2" Margin="9,1,9,0" VerticalAlignment="Top" CornerRadius="1"
                                Background="{StaticResource AccentFill}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="TextElement.Foreground" Value="{StaticResource Text}" />
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHover}" />
                            <Setter TargetName="ul" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="TextElement.Foreground" Value="{StaticResource Text}" />
                            <Setter TargetName="bd" Property="TextElement.FontWeight" Value="SemiBold" />
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Panel}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Divider}" />
                            <Setter TargetName="ul" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- スクロールバー。既定の重いグレーの部品だとダークテーマで浮くため、
         レールを透明にした細いいつまみだけに置き換える。 -->
    <Style x:Key="ScrollRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="tb" CornerRadius="3" Margin="2" Background="{StaticResource ThumbBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tb" Property="Background" Value="{StaticResource ThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="tb" Property="Background" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 幅は size-scrollbar、溝とつまみは color-scrollbar-*。 -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource ScrollTrack}" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollRepeat}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollRepeat}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollRepeat}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollRepeat}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- オーバーレイ本体。影は使わず、枠と面の差だけで窓から浮いて見せる -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- オーバーレイの外枠。必ず枠（DockGroupPanel）いっぱいに敷かれ、境目の線も枠の側が描くので、
         ここは面の色だけを持つ。 -->
    <Style x:Key="OverlayCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 設定画面のタブ。ドッキングのタブ（DockTab）と同じ見え方に揃える。裏のタブは文字だけ、
         表のタブだけを中身と同じ Panel で塗り、上と左右の枠を付けて下端を中身の上枠に 1px 重ねる。
         タブ列を中身の左端から少し内へ寄せてあるのは、中身の角丸と表のタブの左辺が重なって
         角が欠けて見えるのを避けるため。 -->
    <Style x:Key="SettingsTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TabItem">
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1,1,1,0" />
                    <Setter Property="Padding" Value="12,7,12,7" />
                    <Setter Property="Margin" Value="0,0,2,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Root"
                                        Padding="{TemplateBinding Padding}"
                                        Margin="{TemplateBinding Margin}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6,6,0,0"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        <Setter Property="Background" Value="{StaticResource RowHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        <Setter Property="Background" Value="{StaticResource Panel}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Divider}" />
                                        <Setter Property="Margin" Value="0,0,2,-1" />
                                        <Setter Property="Padding" Value="12,7,12,8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0" IsItemsHost="True" Margin="6,0,6,0" Panel.ZIndex="1" />
                        <Border Grid.Row="1"
                                Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Divider}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- タブの見出し。掴んで別の枠へ運ぶ取っ手も兼ねる（v:OverlayDrag.IsGrip） -->
    <!-- 枠のタブ。裏のタブは面も枠も持たず、タブ列（HeaderFill）に文字だけを置く。裏まで箱で囲むと
         タブが増えたときに縦線ばかりが並び、表のタブを探しにくい。表のタブだけを中身と同じ Panel で
         塗り、上と左右に枠を付けて、下端を区切り線に 1px 重ねて中身と一枚につなげる。
         裏にも同じ太さの透明な枠を持たせてあるのは、表裏の切り替えで文字の位置がずれないようにするため。
         高さは行なりに伸ばす（VerticalAlignment は既定の Stretch）。閉じるボタンの有無でタブの
         背は変わるので、伸ばさないと表のタブが区切り線まで届かず、中身との間に隙間が残る。 -->
    <Style x:Key="DockTab" TargetType="Border">
        <Setter Property="CornerRadius" Value="6,6,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <!-- 閉じるボタンの有無に関わらず左右対称。片方だけ小さくすると、閉じるボタンの無い
             据え置きタブ（検索・単語詳細）で文字列が右へ寄って見える。 -->
        <Setter Property="Padding" Value="10,5,10,5" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Muted}" />
        <Style.Triggers>
            <!-- hover は表のタブより前に書く。後に書くと表のタブに触れたときに面が上書きされ、
                 中身との地続きが切れる。 -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RowHover}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{StaticResource Panel}" />
                <Setter Property="BorderBrush" Value="{StaticResource Divider}" />
                <!-- 下の -1 は区切り線との重ね代。0 に戻すと線がタブの下を通り、中身と切り離されて見える。
                     文字は箱の中央に来るので、下へ伸びたぶん（重ね代 1px）は Padding 下に足して
                     中央を押し戻し、裏のタブと文字の高さを揃える。 -->
                <Setter Property="Margin" Value="0,0,2,-1" />
                <Setter Property="Padding" Value="10,5,10,6" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource Text}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- タブの閉じるボタンの出し分け。表のタブと、カーソルが乗っているタブでだけ見せる。
         Visibility ではなく Opacity で消すのは、出し入れのたびにタブの幅が変わって列が揺れるため。
         祖先の Border は DockTab（ボタン自身のテンプレート内の Border は子孫なので当たらない）。 -->
    <Style x:Key="DockTabCloseButton" TargetType="Button" BasedOn="{StaticResource TabCloseButton}">
        <Setter Property="Opacity" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 枠と枠の境目のつまみ。当たり判定は太さ（DockSplit.GripThickness）いっぱいに取りつつ、見せる線は
         中央の 1px だけにする。つまみ全体を塗ると、枠の間に太い帯が走って画面が細切れに見える。
         縦線と横線を両方持っておき、DataContext（DockSplit）の割り方で片方だけ出す。 -->
    <Style x:Key="GripThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="vline" Width="1" HorizontalAlignment="Center" Background="{StaticResource Divider}" />
                        <Border x:Name="hline" Height="1" VerticalAlignment="Center" Background="{StaticResource Divider}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsColumns}" Value="False">
                            <Setter TargetName="vline" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="hline" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- 触れたときだけ線を太くしてアクセント色にし、「動かせる」ことを伝える -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="vline" Property="Width" Value="3" />
                            <Setter TargetName="hline" Property="Height" Value="3" />
                            <Setter TargetName="vline" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="hline" Property="Background" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="vline" Property="Width" Value="3" />
                            <Setter TargetName="hline" Property="Height" Value="3" />
                            <Setter TargetName="vline" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="hline" Property="Background" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ドロップ先の着色。枠そのものが当たり判定なので、ここは枠いっぱいに重ねるだけで
         大きさを持たない（当たり判定を邪魔しないよう素通りさせる） -->
    <Style x:Key="DropHighlight" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DropFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- 結合の下見。消える側の枠を丸ごと塗る -->
    <Style x:Key="JoinHighlight" TargetType="Border" BasedOn="{StaticResource DropHighlight}">
        <Setter Property="Background" Value="{StaticResource JoinFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
    </Style>

    <!-- 枠の四隅のつまみ。普段は見えず、触れたときだけ「引ける角」だと分かる印を出す
         （面は透明でも当たり判定は残るので、掴む場所は常にここにある） -->
    <Style x:Key="AreaCorner" TargetType="Border">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Cursor" Value="SizeAll" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentDim}" />
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- まだタブの無い枠の案内 -->
    <Style x:Key="AreaHintLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=body}" />
    </Style>

    <!-- 単語詳細の節。囲みを積み重ねるとカードの縁ばかりが目に付き、本文より枠が強く出るため、
         区切りは上辺の一本線と余白だけに留める。 -->
    <Style x:Key="DetailSection" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Divider}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,12,0,0" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <!-- 単語詳細の添え字（品詞・内容の見出し・関連の種別など）。詳細面に出る文字は
         本文＝継承の 14 と、この 13 の 2 つだけに揃えてある。欄ごとに FontSize を直書きすると
         訳語欄と内容欄のように大きさがずれるので、必ずこの style を経由させること。 -->
    <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=body}" />
    </Style>

    <Style x:Key="DetailLabelText" TargetType="{x:Type v:SelectableText}" BasedOn="{StaticResource {x:Type v:SelectableText}}">
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=body}" />
    </Style>

    <!-- 詳細面に残す数少ない見出し（行の添え字だけでは何の節か読めないもの）。
         SectionHeading と役目は同じだが、詳細面では添え字と同じ 13 に合わせる。 -->
    <Style x:Key="DetailSectionHeading" TargetType="TextBlock" BasedOn="{StaticResource DetailLabel}">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <!-- 検索条件のような、面として固める小さな区切り -->
    <Style x:Key="FilterCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- プルダウン（v:DropDown）。一覧は Popup ではなくウィンドウの AdornerLayer に描くため、
         OBS のウィンドウキャプチャにも映る。DropDownPanel / DropDownList はコントロール側が
         キー名で引くので、名前を変えるときは DropDown.cs も合わせること。 -->
    <Style TargetType="{x:Type v:DropDown}">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:DropDown}">
                    <Grid>
                    <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 暗黙の TextBlock スタイル（Wrap）が効くと、選んだ値が折り返して
                                 行の高さが揺れるため、どちらも 1 行に固定する。
                                 選んだ値は辞書データ（品詞・関係名）なので、入力欄と同じく表示言語の
                                 フォントは継がせない。案内文字（ph）は UI 文字列なのでそのまま。 -->
                            <TextBlock x:Name="txt" Grid.Column="0" Text="{TemplateBinding SelectionText}"
                                       FontFamily="{x:Static res:Strings.ContentFont}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ph" Grid.Column="0"
                                       v:LocalizedText.Text="{Binding Placeholder, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource Muted}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />
                            <!-- 一覧に無い値も打てる形。枠は外側の Border が描くので、ここは面と枠を消す。
                                 TextBox はクリックを自分で握るので、開閉は矢印側の余白で受ける。 -->
                            <TextBox x:Name="edit" Grid.Column="0" Visibility="Collapsed"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     v:Placeholder.Text="{TemplateBinding Placeholder}"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <Path x:Name="arrow" Grid.Column="1" Data="M 0,0 L 9,0 L 4.5,5.5 Z"
                                  Fill="{StaticResource Muted}" Margin="6,0,10,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border x:Name="ring" CornerRadius="8" BorderThickness="2" IsHitTestVisible="False"
                            BorderBrush="{StaticResource Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasSelection" Value="False">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="edit" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="txt" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Cursor" Value="IBeam" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="arrow" Property="Fill" Value="{StaticResource Text}" />
                        </Trigger>
                        <!-- 打ち込める形は入力欄なので、入力欄と同じく枠でフォーカスを示す。選ぶだけの形は FocusVisualStyle に任せる。 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsOpen" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="arrow" Property="Fill" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Disabled}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Disabled}" />
                            <Setter TargetName="txt" Property="Foreground" Value="{StaticResource OnDisabled}" />
                            <Setter TargetName="arrow" Property="Fill" Value="{StaticResource OnDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 開いた一覧の器。影を使わない方針なので、下地（Panel）より一段明るい面と、Line より明るい枠で
         せり出して見せる。枠をアクセント色にすると、中の選択行（AccentDim）と色がぶつかる。 -->
    <Style x:Key="DropDownPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HeaderFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>

    <Style x:Key="DropDownList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Padding" Value="0" />
        <!-- 一覧に並ぶのは辞書データ（品詞・関係名）。器は AdornerLayer なので窓の
             フォントを継いでしまう。階層メニュー（v:MenuButton）は中身が UI 文字列なので、
             同じ器でもこの Style は使わない。 -->
        <Setter Property="FontFamily" Value="{x:Static res:Strings.ContentFont}" />
    </Style>

    <!-- 階層メニューのボタン（v:MenuButton）。見た目は隣に並ぶ ToolbarButton に合わせ、
         末尾に開閉の三角だけ足す。中身（MenuActionSpec の列）は DropDownPanel と同じ器で
         AdornerLayer に描く。 -->
    <Style TargetType="{x:Type v:MenuButton}">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:MenuButton}">
                    <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                            <TextBlock v:LocalizedText.Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                            <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{TemplateBinding Foreground}"
                                  Opacity="0.6" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHover}" />
                        </Trigger>
                        <!-- 開いている間は hover の面を残し、どのボタンから一覧が出ているかを示す -->
                        <Trigger Property="IsOpen" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 一覧の行に付ける操作メニュー（v:MenuButton）。見た目は IconButton（⋯）そのままで、
         中身は MenuButton の仕組みをそのまま借りる（右クリックでも同じものを開けるよう Open() を公開） -->
    <Style x:Key="RowMenuButton" TargetType="{x:Type v:MenuButton}">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <!-- 操作範囲は size-target-pointer（28）を下回らせない -->
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:MenuButton}">
                    <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}">
                        <TextBlock x:Name="txt"
                                   v:LocalizedText.Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHover}" />
                            <Setter TargetName="txt" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsOpen" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHover}" />
                            <Setter TargetName="txt" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 開いた一覧の中身。DropDownPanel（面・枠）を外側に被せるので、ここは項目を縦に並べるだけ -->
    <Style x:Key="MenuActionList" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 開いた一覧の 1 行。枠付きのボタンを器（DropDownPanel）の中に積むと囲みが二重になり、
         項目名より線のほうが目立つので、行は hover の面だけで示す（tokens.md「メニューリスト」）。 -->
    <Style x:Key="MenuItemButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Margin" Value="0,1" />
    </Style>

    <!-- 項目 1 つぶん。保存など IsPrimary の項目だけ、文字色と太さで強調する
         （並びの中で見失わないように。面で塗ると 1 行だけ囲みが復活して浮く）。
         ショートカットは項目の右端に出す（ZasDesignSystem rules.md「パソコンのソフトにはメニューバーを設ける」）。
         GroupStart の項目の上には区切り線を引く。区切り線は項目ごと隠れるよう、ボタンと同じ入れ物に入れる。 -->
    <DataTemplate x:Key="MenuActionTemplate" DataType="{x:Type med:MenuActionSpec}">
        <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolVis}}">
            <Border Height="1" Margin="6,4" Background="{StaticResource Divider}"
                    Visibility="{Binding GroupStart, Converter={StaticResource BoolVis}}" />
            <Button ToolTip="{Binding ToolTip}" IsEnabled="{Binding IsEnabled}"
                    AutomationProperties.AcceleratorKey="{Binding Shortcut}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MenuItemButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ToolTip}" Value="">
                                <Setter Property="ToolTip" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" Margin="24,0,0,0"
                               Foreground="{StaticResource Muted}" FontWeight="Normal"
                               TextWrapping="NoWrap" VerticalAlignment="Center" />
                    <TextBlock v:LocalizedText.Text="{Binding Label}" Style="{x:Null}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
        </StackPanel>
    </DataTemplate>

    <!-- メニューバーの見出し（v:MenuButton）。標準のメニューバーと同じく、枠も開閉の三角も持たない。
         Tab の移動先に含めない（Alt か F10 で移る）。下線はリンクと紛れるので引かない。 -->
    <Style x:Key="MenuBarButton" TargetType="{x:Type v:MenuButton}">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:MenuButton}">
                    <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                        <TextBlock v:LocalizedText.Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsOpen" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ラジオグループ（ZasDesignSystem components.md「ラジオグループ」、implementation/wpf.md「ラジオグループ」）。
         外枠は RadioGroupFrame、中の並びに v:RadioGroup.IsGroup を付け、選択肢は RadioGroupItem の RadioButton。
         区切り線と両端の角丸は v:RadioGroup が並びの位置から付ける（外枠の Border は子の背景を角丸で切り抜かない）。 -->
    <Style x:Key="RadioGroupFrame" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="RadioGroupItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- size-control-sm。文字が大きくなれば高さを伸ばす -->
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <!-- Tab では選択中の選択肢にだけ止まる。グループの中は矢印キーで移る（v:RadioGroup）。 -->
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- 選択中の印（標準の丸）は描かない。印の分だけ文字が動く。 -->
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding (v:RadioGroup.ItemCornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="False" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource ButtonHover}" />
                <Setter Property="Foreground" Value="{StaticResource ButtonTextHover}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="False" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource ButtonActive}" />
                <Setter Property="Foreground" Value="{StaticResource ButtonTextActive}" />
            </MultiTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentFill}" />
                <Setter Property="Foreground" Value="{StaticResource OnFill}" />
                <Setter Property="IsTabStop" Value="True" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsEnabled" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Disabled}" />
                <Setter Property="Foreground" Value="{StaticResource OnDisabled}" />
            </MultiTrigger>
            <!-- 高コントラストでは選択中を図と地の反転で示す。 -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{x:Static SystemColors.HighlightBrush}" />
                <Setter Property="Foreground" Value="{x:Static SystemColors.HighlightTextBrush}" />
            </MultiDataTrigger>
            <!-- フォーカスの枠が隣の選択肢に隠れないよう前面に出す。 -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Panel.ZIndex" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 縦一列のラジオグループの選択肢。文字は左に寄せる。 -->
    <Style x:Key="RadioGroupItemVertical" TargetType="RadioButton" BasedOn="{StaticResource RadioGroupItem}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- ラジオグループの見出し。横一列では左に置く。 -->
    <Style x:Key="RadioGroupHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

</ResourceDictionary>
