<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:ZasDictWin.Views"
                    xmlns:vm="clr-namespace:ZasDictWin.ViewModels">

    <v:BoolToVisibilityConverter x:Key="BoolVis" />
    <v:EnumMatchConverter x:Key="EnumMatch" />
    <v:NullToVisibilityConverter x:Key="NullVis" />
    <v:CountToVisibilityConverter x:Key="CountVis" />
    <v:StringToBrushConverter x:Key="StringBrush" />
    <v:EqualsMultiConverter x:Key="EqualsMulti" />
    <v:ScaleFontSizeConverter x:Key="ScaleFont" />
    <v:SplitMarginConverter x:Key="SplitMargin" />

    <!-- 配色トークン。キー名は据え置きで値だけ更新しているので、参照側（オーバーレイ含む）はそのまま動く。
         Ink=窓 / Panel=ヘッダ・カード / Raised=ボタン と役割で揃える。影系 Effect は一切使わない方針
         （ビットマップ化されると文字がにじみ、OBS のウィンドウキャプチャ画質を落とすため）。 -->
    <Color x:Key="InkColor">#0B0E15</Color>
    <Color x:Key="PanelColor">#141A26</Color>
    <Color x:Key="RaisedColor">#1F2738</Color>
    <Color x:Key="LineColor">#2C364B</Color>
    <Color x:Key="AccentColor">#A78BFA</Color>

    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Text" Color="#EAEDF6" />
    <SolidColorBrush x:Key="Muted" Color="#93A2BE" />
    <SolidColorBrush x:Key="Danger" Color="#EE6A66" />
    <SolidColorBrush x:Key="Scrim" Color="#D9070910" />

    <!-- 上記から分岐する細部用 -->
    <SolidColorBrush x:Key="Field" Color="#0F141E" />
    <SolidColorBrush x:Key="RowHover" Color="#1B2333" />
    <SolidColorBrush x:Key="AccentDim" Color="#2A2450" />
    <!-- ドロップ先として着色する枠の面。下の中身を透かして「どの枠に入るか」を見せる -->
    <SolidColorBrush x:Key="DropFill" Color="{StaticResource AccentColor}" Opacity="0.22" />
    <!-- 結合で消える側の面。タブは残る枠へ移るが、枠そのものは無くなるので色を分ける -->
    <SolidColorBrush x:Key="JoinFill" Color="#EE6A66" Opacity="0.20" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#3B4763" />
    <SolidColorBrush x:Key="ThumbHover" Color="#516087" />

    <!-- アクセント面。保存ボタン・ロゴ・選択マーカーで同じグラデーションを使い、単色より奥行きを出す -->
    <LinearGradientBrush x:Key="AccentFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B7A0FF" Offset="0" />
        <GradientStop Color="#8A6BF2" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F5877F" Offset="0" />
        <GradientStop Color="#DC5250" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B2231" Offset="0" />
        <GradientStop Color="#141A26" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FooterFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#111722" Offset="0" />
        <GradientStop Color="#171E2C" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 明示的な Style を指定すると既定（暗黙の）TextBlock スタイルが打ち消されるため、折り返しは
         ここで再度宣言する必要がある。省略すると長い案内文が幅を超えて横にはみ出し、オーバーレイ側で
         横スクロールを封じているために末尾が切れて読めなくなる。 -->
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- 節の見出し。TextBlock には Border プロパティがなく、左ラインを背景で描く手も
         SpreadMethod="None" が WPF に存在しないため使えない。字ヅラと色だけで本文との階層を
         分け、かたまりの区切りはカード枠に担わせる。 -->
    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- 表示するものがないことを伝える案内 -->
    <Style x:Key="EmptyState" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=13}" />
        <!-- Stretch にしておかないと要素が内容幅で自動サイズになり、折り返さずにはみ出す -->
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="24" />
    </Style>

    <!-- ボタン。hover / press は白・黒のヴェールで表現する。背景そのものを書き換えると
         Primary などのグラデーションが潰えるため、重ねる方式に統一している。
         hover で枠色も変えないのは、Primary/Danger の枠を灰色に汚さないため。 -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                            <Border x:Name="veil" CornerRadius="7" Background="#FFFFFF" Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="veil" Property="Opacity" Value="0.07" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="veil" Property="Background" Value="#000000" />
                            <Setter TargetName="veil" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentFill}" />
        <Setter Property="Foreground" Value="#170F28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerFill}" />
        <Setter Property="Foreground" Value="#1D0C0C" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- 枠を取っ払った軽いボタン。hover で文字自体を明るくして押せることを示す -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="MinHeight" Value="28" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 戻る／進むなど、記号一文字を並べるツールバー用 -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=14}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ウィンドウを閉じるボタン。hover で他の IconButton と違い赤面にして、押すと閉じる操作だと
         強調する（最小化・最大化と誤って隣接クリックしないための視覚差） -->
    <Style x:Key="CloseIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerFill}" />
                <Setter Property="Foreground" Value="#1D0C0C" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 検索条件の切り替え。単体でも選んだ状態が分かるよう、ON は淡い紫の面＋アクセント枠にする
         （全面をアクセント色で塗ると 8 個並んだときに主張が強すぎるため）。 -->
    <!-- chip の角は「長丸（CornerRadius=999）」ではなく角丸にする。ピルだと文字数の少ない
         項目（「訳語」「名詞」など）がほぼ真円に見えて、隣の角丸のボタンや入力欄と形が揃わない。
         半径はボタンの 8・カードの 12 より一段小さい 6 で、要素の大きさと段を合わせている。 -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <Border x:Name="veil" CornerRadius="5" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDim}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="veil" Property="Opacity" Value="0.07" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 入力欄。v:Placeholder.Text を付けると、空のときだけ薄い案内文字が出る -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                            <!-- 案内文字は 1 行。NoWrap を書かないと暗黙の TextBlock スタイル（Wrap）が効いて
                                 折り返してしまい、TextTrimming が働かない -->
                            <TextBlock x:Name="ph"
                                       Text="{Binding Path=(v:Placeholder.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       Foreground="{StaticResource Muted}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 既定の CheckBox は明るい灰の箱で、ダークテーマに馴染まないため作り直す。
         チェックは Path で描く（記号フォントの有無に依存しない）。 -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                                Background="{StaticResource Field}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="check" Data="M 3.4,8.6 L 7.0,12.0 L 14.2,4.6"
                                  Stroke="#170F28" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="None" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource AccentFill}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ツールチップは既定が白背景なので、ダークテーマに合わせたカードに差し替える -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="#242D42" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 一覧。全行に下線を引く区切りはやめ、角丸の行として hover / 選択を出す。
         選択行は左の細いバーで示す（背景だけより走査しやすい）。 -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="mark" Grid.Column="0" CornerRadius="2" Margin="0,3,7,3"
                                    Background="{StaticResource AccentFill}" Opacity="0" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDim}" />
                            <Setter TargetName="mark" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- 選択タブは下線だけで示す（面を塗るより軽い）。
         文字色と太さは TabItem 本体ではなくヘッダーの Border（bd）に載せること。TabItem の
         Content（＝タブページの中身）は論理ツリー上 TabItem の子なので、TabControl の
         表示領域に描かれていても TabItem からの継承が届く。Foreground や FontWeight を
         TabItem に置くと、選択中のページの中身まで丸ごとその色・太さになる。
         とくに FlowDocument（凡例タブ）は自前で FontWeight を持たないため全文が太字になる。 -->
    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{StaticResource Muted}">
                            <!-- ContentSource="Header" は必須。省略すると ContentPresenter が TabItem.Content、
                                 つまりページ本体をヘッダー枠の中に描いてしまう。TabPanel は子を無限サイズで
                                 測るため、内側の ScrollViewer に高さが渡らずスクロールできなくなり、
                                 FlowDocument は無限幅で Arrange されて WPF 側で回復不能なクラッシュ
                                 （PtsHost の FailFast）にまで至る。既定テンプレートと同じ形に固定する。 -->
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="ul" Height="2" VerticalAlignment="Bottom" CornerRadius="1"
                                Background="{StaticResource AccentFill}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="TextElement.Foreground" Value="{StaticResource Text}" />
                            <Setter TargetName="ul" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="TextElement.Foreground" Value="{StaticResource Text}" />
                            <Setter TargetName="bd" Property="TextElement.FontWeight" Value="SemiBold" />
                            <Setter TargetName="bd" Property="Background" Value="#121A28" />
                            <Setter TargetName="ul" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- スクロールバー。既定の重いグレーの部品だとダークテーマで浮くため、
         レールを透明にした細いいつまみだけに置き換える。 -->
    <Style x:Key="ScrollRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="tb" CornerRadius="4" Margin="2" Background="{StaticResource ThumbBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tb" Property="Background" Value="{StaticResource ThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="tb" Property="Background" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollRepeat}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollRepeat}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollRepeat}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollRepeat}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- オーバーレイ本体。影は使わず、枠と面の差だけで窓から浮いて見せる -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="#3C4761" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- オーバーレイの外枠。必ず辺に付くので、枠と角の丸みは束ねる DockGroupPanel 側に任せ、
         ここは面の色だけを持つ。 -->
    <Style x:Key="OverlayCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- タブの見出し。掴んで別の枠へ運ぶ取っ手も兼ねる（v:OverlayDrag.IsGrip） -->
    <Style x:Key="DockTab" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,2,4,2" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentDim}" />
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource Text}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 幅・高さを引っ張るつまみ。太さは呼び出し側が決め、ここは色の出し分けだけを持つ -->
    <Style x:Key="GripThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="grip" Background="{StaticResource Line}" />
                    <ControlTemplate.Triggers>
                        <!-- 太さは常に同じ。触れたときだけアクセント色にして「動かせる」ことを伝える -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="grip" Property="Background" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="grip" Property="Background" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ドロップ先の着色。枠そのものが当たり判定なので、ここは枠いっぱいに重ねるだけで
         大きさを持たない（当たり判定を邪魔しないよう素通りさせる） -->
    <Style x:Key="DropHighlight" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DropFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- 結合の下見。消える側の枠を丸ごと塗る -->
    <Style x:Key="JoinHighlight" TargetType="Border" BasedOn="{StaticResource DropHighlight}">
        <Setter Property="Background" Value="{StaticResource JoinFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
    </Style>

    <!-- 枠の四隅のつまみ。普段は見えず、触れたときだけ「引ける角」だと分かる印を出す
         （面は透明でも当たり判定は残るので、掴む場所は常にここにある） -->
    <Style x:Key="AreaCorner" TargetType="Border">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Cursor" Value="SizeAll" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentDim}" />
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- まだタブの無い枠の案内 -->
    <Style x:Key="AreaHintLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
    </Style>

    <!-- 検索条件のような、面として固める小さな区切り -->
    <Style x:Key="FilterCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="Separator" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Line}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="2,8" />
    </Style>

    <!-- プルダウン（v:DropDown）。一覧は Popup ではなくウィンドウの AdornerLayer に描くため、
         OBS のウィンドウキャプチャにも映る。DropDownPanel / DropDownList はコントロール側が
         キー名で引くので、名前を変えるときは DropDown.cs も合わせること。 -->
    <Style TargetType="{x:Type v:DropDown}">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:DropDown}">
                    <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 暗黙の TextBlock スタイル（Wrap）が効くと、選んだ値が折り返して
                                 行の高さが揺れるため、どちらも 1 行に固定する -->
                            <TextBlock x:Name="txt" Grid.Column="0" Text="{TemplateBinding SelectionText}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ph" Grid.Column="0" Text="{TemplateBinding Placeholder}"
                                       Foreground="{StaticResource Muted}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />
                            <!-- 一覧に無い値も打てる形。枠は外側の Border が描くので、ここは面と枠を消す。
                                 TextBox はクリックを自分で握るので、開閉は矢印側の余白で受ける。 -->
                            <TextBox x:Name="edit" Grid.Column="0" Visibility="Collapsed"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     v:Placeholder.Text="{TemplateBinding Placeholder}"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <Path x:Name="arrow" Grid.Column="1" Data="M 0,0 L 9,0 L 4.5,5.5 Z"
                                  Fill="{StaticResource Muted}" Margin="6,0,10,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasSelection" Value="False">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="edit" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="txt" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Cursor" Value="IBeam" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="arrow" Property="Fill" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsOpen" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDim}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="arrow" Property="Fill" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 開いた一覧の器。下地のカードからせり出して見えるよう、枠をアクセント色にする -->
    <Style x:Key="DropDownPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>

    <Style x:Key="DropDownList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 階層メニューのボタン（v:MenuButton）。見た目は通常の Button に合わせ、末尾に開閉の三角だけ足す。
         中身（v:MenuAction の列）は DropDownPanel と同じ器で AdornerLayer に描く。 -->
    <Style TargetType="{x:Type v:MenuButton}">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:MenuButton}">
                    <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                            <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{TemplateBinding Foreground}"
                                  Opacity="0.6" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsOpen" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDim}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 開いた一覧の中身。DropDownPanel（面・枠）を外側に被せるので、ここは項目を縦に並べるだけ -->
    <Style x:Key="MenuActionList" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 項目 1 つぶん。保存など IsPrimary の項目だけ、元のツールバーにあった PrimaryButton と
         同じアクセント面で強調する（並びの中で見失わないように）。 -->
    <DataTemplate x:Key="MenuActionTemplate" DataType="{x:Type v:MenuAction}">
        <Button Content="{Binding Header}" ToolTip="{Binding ToolTip}" Command="{Binding Command}"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolVis}}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Margin="0,1" Padding="10,7">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentFill}" />
                            <Setter Property="Foreground" Value="#170F28" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </DataTemplate>

</ResourceDictionary>
