<Window x:Class="ZasDictWin.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZasDictWin.ViewModels"
        Title="{Binding Title, StringFormat={}ZasDict {0}}"
        MinWidth="260" MinHeight="200"
        Background="{StaticResource Ink}"
        FontFamily="Yu Gothic UI"
        FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=14}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize">

    <!-- 本体の窓から持ち出したタブ。DataContext は DockFloat。
         中身は本体とまったく同じ割り付け（枠と境目の入れ子）なので、この窓の中でも
         枠を割れるし、タブを掴んで本体へ運び戻すこともできる。
         枠の面と縁は DockGroupPanel が持つため、ここは題と大きさだけを受け持つ。 -->
    <ContentControl Content="{Binding Root}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
</Window>
