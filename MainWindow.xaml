<Window x:Class="ZasDictWin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ZasDictWin.Views"
        xmlns:vm="clr-namespace:ZasDictWin.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="{StaticResource Ink}"
        FontFamily="Yu Gothic UI"
        FontSize="{Binding BaseFontSize}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}" />
        <!-- どちらも検索欄の文字列を見出し語の初期値にして単語エディタを開く -->
        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding NewWordCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewWordCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditWordCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateWordCommand}" />
    </Window.InputBindings>

    <Grid>
        <DockPanel>

            <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1" Padding="14,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="←" Style="{StaticResource GhostButton}"
                                FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=18}"
                                Command="{Binding BackCommand}"
                                Visibility="{Binding IsBackVisible, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="{Binding DictionaryName}" FontWeight="SemiBold"
                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=17}"
                                   VerticalAlignment="Center" Margin="4,0,6,0" />
                        <TextBlock Text="*" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=17}"
                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolVis}}" />
                    </StackPanel>

                    <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="開く" Command="{Binding OpenCommand}" />
                        <Button Content="新規辞書" Command="{Binding NewDictionaryCommand}" />
                        <Button Content="保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                        <Button Content="別名で保存" Command="{Binding SaveAsCommand}" />
                        <Border Width="1" Background="{StaticResource Line}" Margin="6,2" />
                        <Button Content="＋ 単語" Command="{Binding NewWordCommand}" />
                        <Button Content="ツール" Command="{Binding ShowToolsCommand}" />
                        <Button Content="凡例・統計" Command="{Binding ShowInfoCommand}" />
                        <Button Content="設定" Command="{Binding ShowSettingsCommand}" />
                        <Border Width="1" Background="{StaticResource Line}" Margin="6,2" />
                        <Button x:Name="LayoutButton" Content="レイアウト切替" Command="{Binding ToggleLayoutCommand}" />
                        <Button x:Name="BrowserButton" Content="{Binding Browser.ToggleLabel}"
                                Command="{Binding Browser.ToggleCommand}" ToolTip="右にウェブブラウザのサイドバーを開閉します" />
                        <Button x:Name="StreamButton" Content="単語ウィンドウ" Click="ToggleStreamWindow_Click" Margin="0" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,1,0,0" Padding="14,7">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}" Foreground="{StaticResource Muted}"
                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}"
                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- 右サイドバーのブラウザ。WebView2 はメインウィンドウの子 HWND なので OBS の
                 ウィンドウキャプチャにそのまま映るが、airspace のため WPF 描画より手前に出る。
                 オーバーレイ開期中は IsBrowserShown が隠す。 -->
            <Grid DockPanel.Dock="Right" Width="{Binding Browser.Width}"
                  Visibility="{Binding IsBrowserShown, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- GridSplitter は行・列そのものを伸縮させるので幅バインドと衝突する。
                     ドラッグ量を VM の幅に反映する（Thumb は GridSplitter の親クラス）。 -->
                <Thumb Grid.Column="0" Cursor="SizeWE"
                       DragDelta="BrowserGrip_DragDelta" DragCompleted="BrowserGrip_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{StaticResource Line}" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <v:BrowserPanel Grid.Column="1" DataContext="{Binding Browser}" />
            </Grid>

            <Grid>
                <!-- 分割レイアウト: デスクトップ作業向け -->
                <Grid Visibility="{Binding IsSplitLayout, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" MinWidth="300" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <v:SearchPanel Grid.Column="0" />
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                  Background="{StaticResource Line}" />
                    <v:DetailPanel Grid.Column="2" />
                </Grid>

                <!-- 遷移レイアウト: 配信向け。1画面ずつ大きく見せる -->
                <Grid Visibility="{Binding IsNavigateLayout, Converter={StaticResource BoolVis}}">
                    <v:SearchPanel Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolVis}}" />
                    <v:DetailPanel Visibility="{Binding IsBackVisible, Converter={StaticResource BoolVis}}" />
                </Grid>
            </Grid>
        </DockPanel>

        <!-- オーバーレイ層。MessageBox や ContextMenu は別 HWND になり
             OBS のウィンドウキャプチャに映らないため、すべてここに描画する。 -->
        <Border Background="{StaticResource Scrim}"
                Visibility="{Binding IsOverlayOpen, Converter={StaticResource BoolVis}}">
            <ContentControl Content="{Binding CurrentOverlay}" />
        </Border>
    </Grid>
</Window>
