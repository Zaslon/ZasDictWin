<Window x:Class="ZasDictWin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ZasDictWin.Views"
        xmlns:vm="clr-namespace:ZasDictWin.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="{StaticResource Ink}"
        FontFamily="Yu Gothic UI"
        FontSize="{Binding BaseFontSize}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}" />
        <!-- どちらも検索欄の文字列を見出し語の初期値にして単語エディタを開く -->
        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding NewWordCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewWordCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditWordCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateWordCommand}" />
    </Window.InputBindings>

    <Grid>
        <DockPanel>

            <Border x:Name="HeaderBar" DockPanel.Dock="Top" Background="{StaticResource HeaderFill}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1" Padding="12,7">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- アプリの顔。辞書名が長くなるので小さく据える -->
                        <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentFill}"
                                Margin="0,0,9,0" VerticalAlignment="Center">
                            <TextBlock Text="Z" FontSize="13" FontWeight="Bold" Foreground="#170F28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </Border>
                        <Button Content="←" Style="{StaticResource GhostButton}"
                                FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=16}"
                                Command="{Binding BackCommand}"
                                Visibility="{Binding IsBackVisible, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="{Binding DictionaryName}" FontWeight="SemiBold"
                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=15}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <!-- 未保存は「*」よりドット。ラベルと本文の間に記号を挟まない -->
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"
                                 ToolTip="未保存の変更があります"
                                 Visibility="{Binding IsDirty, Converter={StaticResource BoolVis}}" />
                    </StackPanel>

                    <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal"
TextElement.FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}">
                        <Button Content="開く" Command="{Binding OpenCommand}" />
                        <Button Content="新規辞書" Command="{Binding NewDictionaryCommand}" />
                        <Button Content="保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                        <Button Content="別名で保存" Command="{Binding SaveAsCommand}" />
                        <Border Width="1" Background="{StaticResource Line}" Margin="4,3" />
                        <Button Content="＋ 単語" Command="{Binding NewWordCommand}" />
                        <Button Content="例文" Command="{Binding ShowExamplesCommand}"
                                ToolTip="辞書の例文（examples）を一覧・編集します" />
                        <Button Content="ツール" Command="{Binding ShowToolsCommand}" />
                        <Button Content="凡例・統計" Command="{Binding ShowInfoCommand}" />
                        <Button Content="設定" Command="{Binding ShowSettingsCommand}" />
                        <Border Width="1" Background="{StaticResource Line}" Margin="4,3" />
                        <Button x:Name="LayoutButton" Content="レイアウト切替" Command="{Binding ToggleLayoutCommand}" />
                        <Button x:Name="BrowserButton" Content="{Binding Browser.ToggleLabel}"
                                Command="{Binding Browser.ToggleCommand}" ToolTip="右にウェブブラウザのサイドバーを開閉します" />
                        <Button x:Name="StreamButton" Content="単語ウィンドウ" Click="ToggleStreamWindow_Click" Margin="0" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <Border x:Name="FooterBar" DockPanel.Dock="Bottom" Background="{StaticResource FooterFill}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,1,0,0" Padding="12,5">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="6" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CountLabel}" Foreground="{StaticResource Muted}"
                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                    </Border>
                    <!-- フッタは 1 行固定。折り返すと状況によってフッタの高さが変わり、下端の位置が動く -->
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}"
                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}"
                               VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- 右サイドバーのブラウザ。WebView2 はメインウィンドウの子 HWND なので OBS の
                 ウィンドウキャプチャにそのまま映るが、airspace のため WPF 描画より手前に出る。
                 オーバーレイ開期中は IsBrowserShown が隠す。 -->
            <Grid DockPanel.Dock="Right" Width="{Binding Browser.Width}"
                  Visibility="{Binding IsBrowserShown, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- GridSplitter は行・列そのものを伸縮させるので幅バインドと衝突する。
                     ドラッグ量を VM の幅に反映する（Thumb は GridSplitter の親クラス）。 -->
                <Thumb Grid.Column="0" Cursor="SizeWE" Style="{StaticResource GripThumb}"
                       DragDelta="BrowserGrip_DragDelta" DragCompleted="BrowserGrip_DragCompleted" />
                <v:BrowserPanel Grid.Column="1" DataContext="{Binding Browser}" />
            </Grid>

            <!-- 縁にドッキングしたオーバーレイ。スクリムを敷かないので、開いたまま検索や一覧を
                 触れる。ブラウザより内側に置いてあるので、両方出しても場所を取り合わない。 -->
            <DockPanel DockPanel.Dock="{Binding Dock.PanelDock}"
                       Width="{Binding Dock.PanelWidth}" Height="{Binding Dock.PanelHeight}"
                       Visibility="{Binding IsDockedPanelOpen, Converter={StaticResource BoolVis}}">
                <Thumb DockPanel.Dock="{Binding Dock.GripDock}" Cursor="{Binding Dock.GripCursor}"
                       Width="{Binding Dock.GripWidth}" Height="{Binding Dock.GripHeight}"
                       Style="{StaticResource GripThumb}"
                       DragDelta="DockGrip_DragDelta" DragCompleted="DockGrip_DragCompleted" />
                <ContentControl Content="{Binding DockedOverlay}" />
            </DockPanel>

            <Grid>
                <!-- 分割レイアウト: デスクトップ作業向け -->
                <Grid Visibility="{Binding IsSplitLayout, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" MinWidth="300" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <v:SearchPanel Grid.Column="0" />
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                  Background="{StaticResource Line}" />
                    <v:DetailPanel Grid.Column="2" />
                </Grid>

                <!-- 遷移レイアウト: 配信向け。1画面ずつ大きく見せる -->
                <Grid Visibility="{Binding IsNavigateLayout, Converter={StaticResource BoolVis}}">
                    <v:SearchPanel Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolVis}}" />
                    <v:DetailPanel Visibility="{Binding IsBackVisible, Converter={StaticResource BoolVis}}" />
                </Grid>
            </Grid>
        </DockPanel>

        <!-- オーバーレイ層。MessageBox や ContextMenu は別 HWND になり
             OBS のウィンドウキャプチャに映らないため、すべてここに描画する。
             中央表示のときだけスクリムを敷く。ドッキング中は上の DockPanel 側が描く。 -->
        <Border Background="{StaticResource Scrim}"
                Visibility="{Binding IsFloatingPanelOpen, Converter={StaticResource BoolVis}}">
            <ContentControl Content="{Binding FloatingOverlay}" />
        </Border>

        <!-- 確認ダイアログの層。ドッキング中の編集画面を閉じずに上へ重ねるため層を分ける。 -->
        <Border Background="{StaticResource Scrim}"
                Visibility="{Binding ModalOverlay, Converter={StaticResource NullVis}}">
            <ContentControl Content="{Binding ModalOverlay}" />
        </Border>

        <!-- ドロップ先の候補。ヘッダとフッタの実高さぶん内側に寄せて、ドッキングしたときに
             本体が実際に収まる範囲と升目を一致させる。升目の Tag が当たり判定の値そのもので、
             OverlayDrag が InputHitTest で拾う（名前 DockZoneHost もそちらから引かれる）。 -->
        <Grid x:Name="DockZoneHost" Visibility="{Binding Dock.IsDragging, Converter={StaticResource BoolVis}}">
            <Grid.Margin>
                <MultiBinding Converter="{StaticResource EdgeInsets}">
                    <Binding ElementName="HeaderBar" Path="ActualHeight" />
                    <Binding ElementName="FooterBar" Path="ActualHeight" />
                </MultiBinding>
            </Grid.Margin>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource DropZone}" Tag="{x:Static vm:DockSide.Top}" />
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="上にドッキング"
                       Style="{StaticResource DropZoneLabel}" />

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DropZone}" Tag="{x:Static vm:DockSide.Left}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="左に&#10;ドッキング" TextAlignment="Center"
                       Style="{StaticResource DropZoneLabel}" />

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DropZone}" Tag="{x:Static vm:DockSide.Floating}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="中央に戻す" Style="{StaticResource DropZoneLabel}" />

            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DropZone}" Tag="{x:Static vm:DockSide.Right}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="右に&#10;ドッキング" TextAlignment="Center"
                       Style="{StaticResource DropZoneLabel}" />

            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource DropZone}" Tag="{x:Static vm:DockSide.Bottom}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="下にドッキング"
                       Style="{StaticResource DropZoneLabel}" />
        </Grid>
    </Grid>
</Window>
