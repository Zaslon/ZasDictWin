<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZasDictWin</AssemblyName>
    <RootNamespace>ZasDictWin</RootNamespace>
    <ApplicationIcon>ZasDictWin.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- 配布は exe 1 個で完結させる。WebView2 の WebView2Loader.dll はマネージド DLL ではないので
         IncludeNativeLibrariesForSelfExtract を付けないとバンドルから外れて exe の隣に置かれる
         （初回起動時に %TEMP%\.net\ZasDictWin\ へ展開されて読み込まれる）。
         RuntimeIdentifier を固定しないと win-x64 / win-x86 / win-arm64 の 3 種類が出力される。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 自己完結ビルド (-p:SelfContained=true) のときだけ有効な設定。展開に時間はかかるが 3 割ほど縮む。 -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>

    <!-- pdb を別ファイルにすると exe 単体という前提が崩れ、かといって捨てると error.log の
         スタックトレースから行番号が消える。exe に埋め込んで両立させる。 -->
    <DebugType>embedded</DebugType>
    <!-- 参照 NuGet の .xml (WebView2 だけで 0.8MB) と .pdb を出力に持ち込まない。 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>

    <!-- バージョンの末尾（パッチ番号）は VersionPatchFile に永続化する。ファイルの中身は
         「最後に配布した番号」ではなく「次のビルドが名乗る番号」。
         Major.Minor はここで直接編集する。 -->
    <VersionMajor>1</VersionMajor>
    <VersionMinor>2</VersionMinor>
    <VersionPatchFile>$(MSBuildProjectDirectory)\version.patch.txt</VersionPatchFile>

    <!-- 番号を進めるのは人手のビルドだけにする。AI エージェント (Claude Code など) や CI が
         動作確認のために繰り返しビルドすると番号が無駄に飛ぶため、それらのシェルにだけ注入される
         環境変数を見て除外する。CLAUDECODE / AI_AGENT は利用者自身のターミナルには存在しないので、
         人手のビルドと区別できる。
         明示的に制御したいときは -p:BumpVersion=true / -p:BumpVersion=false を渡す。 -->
    <BumpVersion Condition="'$(BumpVersion)' == '' And ('$(CLAUDECODE)' != '' Or '$(AI_AGENT)' != '' Or '$(CI)' != '')">false</BumpVersion>
    <BumpVersion Condition="'$(BumpVersion)' == ''">true</BumpVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!-- WebView2 パッケージは WPF 版と WinForms 版のラッパーを両方入れてくる。使うのは WPF 版だけで、
       Wpf / Core のどちらからも WinForms 版への参照は無いので出力から外す。 -->
  <Target Name="DropWebView2WinForms" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="'%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

  <Target Name="DropWebView2WinFormsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

  <!-- IDE のデザインタイムビルドでは走らせない（IntelliSense のたびに末尾が増えてしまうため）。
       BuildingProject はコンパイルを伴う実ビルドでのみ true になる。
       WPF は XAML コンパイルのため本体とは別に "_wpftmp" という一時プロジェクトでもこのファイルを
       ビルドし直す（本体より先に走る）。ここでも条件に一致してしまい 1 回のビルドで 2 回加算されるため、
       一時プロジェクトでは走らせない。
       GetAssemblyVersion より前に Version を確定させる必要がある。GenerateAssemblyInfo を
       BeforeTargets に指定しても、その DependsOnTargets（CoreGenerateAssemblyInfo 経由で
       GetAssemblyVersion）は先に走ってしまい間に合わない。 -->
  <Target Name="ApplyVersionPatch" BeforeTargets="BeforeBuild;GetAssemblyVersion"
          Condition="'$(BuildingProject)' == 'true' And '$(DesignTimeBuild)' != 'true' And !$(MSBuildProjectName.Contains('_wpftmp'))">
    <ReadLinesFromFile File="$(VersionPatchFile)" Condition="Exists('$(VersionPatchFile)')">
      <Output TaskParameter="Lines" ItemName="_VersionPatchLine" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <VersionPatch>@(_VersionPatchLine)</VersionPatch>
      <VersionPatch Condition="'$(VersionPatch)' == ''">0</VersionPatch>
    </PropertyGroup>
    <!-- 進めないビルドでも Version の組み立ては行う。今回名乗った番号を使い切ったものとして
         書き戻すので、進めるビルドの次は必ず新しい番号になる。 -->
    <WriteLinesToFile Condition="'$(BumpVersion)' == 'true'"
                      File="$(VersionPatchFile)" Lines="$([MSBuild]::Add($(VersionPatch), 1))" Overwrite="true" />
    <PropertyGroup>
      <Version>$(VersionMajor).$(VersionMinor).$(VersionPatch)</Version>
      <AssemblyVersion>$(Version)</AssemblyVersion>
      <FileVersion>$(Version)</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!-- リリース後の後片付け。dotnet clean は最後のビルドが記録したファイルしか消さず publish\ が
       まるごと残るため、次の配布で古い exe を掴む事故になる。ここは bin / obj ごと捨てる。
       単一ファイル exe は起動時に WebView2Loader.dll を %TEMP%\.net\ZasDictWin\<ハッシュ>\ へ
       展開し、ハッシュは publish のたびに変わるので放っておくと溜まりつづける。
       標準の Clean にぶら下げないのは、Rebuild が Clean → Build と走るため。obj を消すと
       project.assets.json ごと失われ、復元前のビルドが失敗する。 -->
  <Target Name="Distclean">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\obj" />
    <!-- アプリを起動したままだと publish\ の exe だけがロックされ、RemoveDir は残りを消したうえで
         MSB3231「アクセスが拒否されました」で止まる。これだけでは理由が読み取れないので、
         いったん警告に落として消し残しから案内し直す。 -->
    <RemoveDir Directories="$(MSBuildProjectDirectory)\bin" ContinueOnError="WarnAndContinue" />
    <RemoveDir Directories="$(TEMP)\.net\$(AssemblyName)" Condition="'$(TEMP)' != ''"
               ContinueOnError="WarnAndContinue" />
    <Error Condition="Exists('$(MSBuildProjectDirectory)\bin')"
           Text="bin\ を削除しきれませんでした。$(AssemblyName).exe を起動したままだとロックされます。終了してからやり直してください。" />
    <Message Importance="high"
             Text="Distclean: bin\ obj\ $(TEMP)\.net\$(AssemblyName)\ を削除しました。" />
  </Target>

</Project>
