<UserControl x:Class="ZasDictWin.Views.Overlays.InfoOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ZasDictWin.Views"
             xmlns:vm="clr-namespace:ZasDictWin.ViewModels">

    <Border Style="{StaticResource OverlayCard}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="24,18" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="閉じる" Style="{StaticResource GhostButton}"
                            Command="{Binding CloseCommand}" Margin="0" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=19}" />
                </DockPanel>
            </Border>

            <!-- 各タブの中身はウィンドウの高さいっぱいまで伸ばす。高さを固定すると
                 文字サイズ倍率を上げたときにスクロール領域だけが極端に狭くなる。 -->
            <TabControl Margin="24,14,24,20">
                <TabItem Header="統計">
                    <!-- 統計・更新履歴とも縦にだけ流す（横スクロールで行順が崩れるのを防ぐ） -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding WordCount}"
                                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=34}" />
                                    <TextBlock Text="見出し語" Style="{StaticResource Label}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding ExampleCount}"
                                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=34}" />
                                    <TextBlock Text="例文" Style="{StaticResource Label}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource Label}" Margin="0,18,0,0">
                                <Run Text="同綴りの見出し語 " /><Run Text="{Binding HomonymCount, Mode=OneWay}" />
                                <Run Text="  ／  平均文字数 " /><Run Text="{Binding AverageFormLength, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Text="品詞（訳語のタイトル）" Style="{StaticResource SectionHeading}" />
                            <!-- 品詞・タグの内訳は横流れの文字列ではなくグリッド状に整列させる。
                                 SharedSizeGroup（更新履歴タブと同じ手法的に ItemsControl をスコープ化）で
                                 全セルの名称列・件数列の幅をそろえ、WrapPanel で折り返す。
                                 固定 px を使わないので文字サイズ倍率にも追従する。 -->
                            <ItemsControl ItemsSource="{Binding PosItems}" Grid.IsSharedSizeScope="True" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,24,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="BreakName" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="BreakCount" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{StaticResource Muted}"
                                                       TextAlignment="Right" Margin="6,0,0,0"
                                                       FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="タグ" Style="{StaticResource SectionHeading}" />
                            <ItemsControl ItemsSource="{Binding TagItems}" Grid.IsSharedSizeScope="True" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,24,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="BreakName" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="BreakCount" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{StaticResource Muted}"
                                                       TextAlignment="Right" Margin="6,0,0,0"
                                                       FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="凡例">
                    <FlowDocumentScrollViewer x:Name="LegendView" Background="Transparent"
                                              IsSelectionEnabled="True"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Margin="0,14,0,0" />
                </TabItem>

                <TabItem Header="更新履歴">
                    <DockPanel Margin="0,14,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="CSV を選び直す" Command="{Binding RelinkChangelogCommand}" />
                                <Button Content="書き出す" Command="{Binding ExportChangelogCommand}" Margin="0" />
                            </StackPanel>
                            <!-- パスは 1 行。Label スタイルが Wrap を宣言しているので明示的に打ち消す -->
                            <TextBlock Text="{Binding ChangelogPath}" Style="{StaticResource Label}" Margin="0"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <!-- 列幅は固定 px にせず、SharedSizeGroup で全行そろえて内容に合わせる。
                             固定にすると文字サイズ倍率を上げたとき「CHANGE」等が折り返す。
                             スコープを見出し行と本文の共通の親にしているため、見出しの列幅も本文とそろう。 -->
                        <Grid Grid.IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 見出し行はスクロール領域の外（Row 0）に置く。本文が何行あっても動かさない。 -->
                            <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ChangeTime" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ChangeType" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ChangeForm" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ChangelogHeader[0]}" Foreground="{StaticResource Muted}"
                                               FontWeight="SemiBold" TextWrapping="NoWrap" Margin="0,0,16,0"
                                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ChangelogHeader[1]}" Foreground="{StaticResource Muted}"
                                               FontWeight="SemiBold" TextWrapping="NoWrap" Margin="0,0,16,0"
                                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ChangelogHeader[2]}" Foreground="{StaticResource Muted}"
                                               FontWeight="SemiBold" TextWrapping="NoWrap" Margin="0,0,16,0"
                                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                                    <TextBlock Grid.Column="3" Text="{Binding ChangelogHeader[3]}" Foreground="{StaticResource Muted}"
                                               FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                                </Grid>
                            </Border>

                            <!-- 履歴は追記順（古い → 新しい）なので、表示時に一度だけ末尾＝最新行へ送る。 -->
                            <ScrollViewer x:Name="ChangelogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Loaded="ChangelogScroll_Loaded">
                                <ItemsControl ItemsSource="{Binding ChangelogRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ChangeTime" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ChangeType" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ChangeForm" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding [0]}" Foreground="{StaticResource Muted}"
                                                           TextWrapping="NoWrap" Margin="0,0,16,0"
                                                           FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                                                <TextBlock Grid.Column="1" Text="{Binding [1]}"
                                                           TextWrapping="NoWrap" Margin="0,0,16,0"
                                                           FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                                                <TextBlock Grid.Column="2" Text="{Binding [2]}"
                                                           TextWrapping="NoWrap" Margin="0,0,16,0"
                                                           FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=13}" />
                                                <TextBlock Grid.Column="3" Text="{Binding [3]}" Foreground="{StaticResource Muted}"
                                                           FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
