<UserControl x:Class="ZasDictWin.Views.DetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:ZasDictWin.Models"
             xmlns:vm="clr-namespace:ZasDictWin.ViewModels">

    <Grid Margin="18,14">

        <TextBlock Text="左の一覧から単語を選ぶと、ここに内容が出ます。"
                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />

        <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}"
                   DataContext="{Binding}">

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="編集" Style="{StaticResource PrimaryButton}" Command="{Binding EditWordCommand}" />
                <Button Content="複製" Command="{Binding DuplicateWordCommand}" />
                <Button Content="削除" Style="{StaticResource DangerButton}" Command="{Binding DeleteWordCommand}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedWord}">

                    <TextBlock Text="{Binding DisplayForm}"
                               FontSize="{Binding DataContext.HeadwordFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontFamily="{Binding Source={x:Static vm:HeadwordFontState.Instance}, Path=Family}" />

                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Raised}" CornerRadius="999" Padding="10,3" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource Muted}"
                                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="訳語" Style="{StaticResource SectionHeading}"
                               Visibility="{Binding Translations.Count, Converter={StaticResource CountVis}}" />
                    <ItemsControl ItemsSource="{Binding Translations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Translation}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{StaticResource Accent}" />
                                    <!-- 訳語は編集欄と同じカンマ区切りで並べる（1 つの TextBlock なので長い場合は折り返す）。 -->
                                    <TextBlock Grid.Column="1" Text="{Binding FormSummary}" TextWrapping="Wrap" Margin="0,0,0,2"
                                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=16}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="変化形" Style="{StaticResource SectionHeading}"
                               Visibility="{Binding Variations.Count, Converter={StaticResource CountVis}}" />
                    <ItemsControl ItemsSource="{Binding Variations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Variation}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}" MinWidth="76" />
                                    <TextBlock Text="{Binding Form}"
                                               FontFamily="{Binding Source={x:Static vm:HeadwordFontState.Instance}, Path=Family}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="内容" Style="{StaticResource SectionHeading}"
                               Visibility="{Binding Contents.Count, Converter={StaticResource CountVis}}" />
                    <ItemsControl ItemsSource="{Binding Contents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:ContentItem}">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Accent}"
                                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=13}" />
                                    <TextBlock Text="{Binding Text}" Margin="0,2,0,0" LineHeight="22" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="関連語" Style="{StaticResource SectionHeading}"
                               Visibility="{Binding Relations.Count, Converter={StaticResource CountVis}}" />
                    <ItemsControl ItemsSource="{Binding Relations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Relation}">
                                <Button Margin="0,0,6,6"
                                        Command="{Binding DataContext.FollowRelationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}" Margin="0,0,8,0"
                                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                                        <TextBlock Text="{Binding Form}"
                                                   FontFamily="{Binding Source={x:Static vm:HeadwordFontState.Instance}, Path=Family}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="24" Background="Transparent" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
