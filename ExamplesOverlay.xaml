<UserControl x:Class="ZasDictWin.Views.Overlays.ExamplesOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:ZasDictWin.Models"
             xmlns:v="clr-namespace:ZasDictWin.Views"
             xmlns:vm="clr-namespace:ZasDictWin.ViewModels">

    <Border Style="{StaticResource Card}" MaxWidth="820" Margin="40,28" Padding="0">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="24,18" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="閉じる" Style="{StaticResource GhostButton}"
                            Command="{Binding CloseCommand}" Margin="0" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=19}" />
                </DockPanel>
            </Border>

            <!-- 追加ボタンと件数はスクロール領域の外。例文が増えても位置が動かないようにする -->
            <Border DockPanel.Dock="Bottom" Padding="24,12,24,18" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="＋ 例文" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddCommand}" Margin="0" />
                    <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Label}" Margin="0"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <DockPanel Margin="24,14,24,0">
                <TextBlock DockPanel.Dock="Top" Text="例文・訳・補足・タグを部分一致で絞り込みます。" Style="{StaticResource Label}" />
                <TextBox DockPanel.Dock="Top" Margin="0,0,0,12"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                         v:Placeholder.Text="例文を検索…" />

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource EmptyState}"
                           Text="表示できる例文がありません。［＋ 例文］から追加できます。"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" />

                <!-- 横スクロールは封じ、長い文は折り返しではなく末尾省略で吸収する -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Examples}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Example}">
                                <Button HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="12,8"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <!-- 1 行目が文、2 行目が訳。ZasDict の 2 行 1 組の並びに合わせる -->
                                        <TextBlock Text="{Binding SentencePreview}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontFamily="{Binding Source={x:Static vm:HeadwordFontState.Instance}, Path=Family}" />
                                        <TextBlock Text="{Binding TranslationPreview}" Foreground="{StaticResource Muted}"
                                                   Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}" />
                                        <TextBlock Text="{Binding TagSummary}" Foreground="{StaticResource Accent}"
                                                   Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Tags.Count, Converter={StaticResource CountVis}}"
                                                   FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=11}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>
    </Border>
</UserControl>
