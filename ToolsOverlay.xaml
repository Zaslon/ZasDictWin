<UserControl x:Class="ZasDictWin.Views.Overlays.ToolsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZasDictWin.ViewModels">

    <Border Style="{StaticResource Card}" MaxWidth="820" Margin="40,28" Padding="0">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="24,18" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="閉じる" Style="{StaticResource GhostButton}"
                            Command="{Binding CloseCommand}" Margin="0" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                               FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=19}" />
                </DockPanel>
            </Border>

            <!-- カードは高さいっぱいまで伸ばし、あふれた分はタブの中でスクロールさせる。
                 文字サイズ倍率を上げても入力欄が画面外に押し出されないようにするため。 -->
            <TabControl Margin="24,14,24,20">
                <TabItem Header="方言変換">
                    <!-- 縦にだけ流す。横スクロールは行の並び順がずれる原因になるので封じる -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="元単語（強勢のある母音を大文字で入力）" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                     FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=20}" />

                            <Grid Margin="0,18,0,0">
                                <!-- 方言名は文字サイズ倍率に合わせて伸びるので、固定幅にすると折り返す -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="旗艦方言 Sekore"
                                           Foreground="{StaticResource Muted}" Margin="0,0,16,10" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Sekore, Mode=OneWay}" IsReadOnly="True"
                                         FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=18}" Margin="0,0,0,10" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="資源循環艦方言 Titauini"
                                           Foreground="{StaticResource Muted}" Margin="0,0,16,10" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Titauini, Mode=OneWay}" IsReadOnly="True"
                                         FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=18}" Margin="0,0,0,10" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="探査艦方言 Kaiko"
                                           Foreground="{StaticResource Muted}" Margin="0,0,16,10" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Kaiko, Mode=OneWay}" IsReadOnly="True"
                                         FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=18}" Margin="0,0,0,10" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="教団暗号 Arzafire"
                                           Foreground="{StaticResource Muted}" Margin="0,0,16,0" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Arzafire, Mode=OneWay}" IsReadOnly="True"
                                         FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=18}" />
                            </Grid>

                            <CheckBox Margin="0,16,0,0" IsChecked="{Binding FaithfulTitauini}"
                                      Content="Titauini で Python 版と同じ挙動を使う（3母音化を捨てる）" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="IPA → 綴り">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="IPA" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding IpaInput, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                     FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=20}" />
                            <TextBlock Text="簡略綴り" Style="{StaticResource Label}" Margin="0,16,0,4" />
                            <TextBox Text="{Binding IpaSpelling, Mode=OneWay}" IsReadOnly="True"
                                     FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=20}" />
                            <TextBlock Style="{StaticResource Label}" Margin="0,10,0,0"
                                       Text="(a|b) は候補が複数あることを表します。" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
