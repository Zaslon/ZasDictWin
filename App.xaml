<Application x:Class="ZasDictWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZasDictWin.ViewModels"
             xmlns:v="clr-namespace:ZasDictWin.Views"
             xmlns:ov="clr-namespace:ZasDictWin.Views.Overlays"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 画面の割り付け。節と枠の入れ子をそのまま描く（再帰は ContentControl 任せ）。 -->
            <DataTemplate DataType="{x:Type vm:DockSplit}">
                <v:DockSplitPanel />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DockLeaf}">
                <v:DockGroupPanel />
            </DataTemplate>

            <!-- タブに並ぶ単語詳細と検索。器は DataContext を持たないので、本体を渡し直す。 -->
            <DataTemplate DataType="{x:Type vm:WordDetailViewModel}">
                <v:DetailPanel DataContext="{Binding Main}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SearchViewModel}">
                <v:SearchPanel DataContext="{Binding Main}" />
            </DataTemplate>
            <!-- ブラウザは器ごと隠せるようにしておく。WebView2 は airspace で確認ダイアログより
                 手前に出てしまうため、ダイアログ中は中身を出さない。 -->
            <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
                <Grid Visibility="{Binding IsContentShown, Converter={StaticResource BoolVis}}">
                    <v:BrowserPanel DataContext="{Binding Browser}" />
                </Grid>
            </DataTemplate>
            <!-- ツール類。タブでも独立ウィンドウでも同じ中身を出す（器は DockGroupPanel が持つ）。 -->
            <DataTemplate DataType="{x:Type vm:DialectToolViewModel}">
                <v:DialectPanel />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:IpaToolViewModel}">
                <v:IpaPanel />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatsViewModel}">
                <v:StatsPanel />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LegendViewModel}">
                <v:LegendPanel />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ChangelogViewModel}">
                <v:ChangelogPanel />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ChoiceViewModel}">
                <ov:ChoiceOverlay />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WordEditViewModel}">
                <ov:WordEditOverlay />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <ov:SettingsOverlay />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExamplesViewModel}">
                <ov:ExamplesOverlay />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExampleEditViewModel}">
                <ov:ExampleEditOverlay />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CommitViewModel}">
                <ov:CommitOverlay />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
