<UserControl x:Class="ZasDictWin.Views.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:ZasDictWin.Models"
             xmlns:v="clr-namespace:ZasDictWin.Views"
             xmlns:vm="clr-namespace:ZasDictWin.ViewModels">

    <DockPanel Margin="12,10,12,0">

        <StackPanel DockPanel.Dock="Top">
            <!-- 検索欄。虫メガネと案内文字を同じ枠に収め、どこへ打つのか一目で分かるようにする。
                 案内は v:Placeholder.Text で、テンプレート側が「空のときだけ」出す（値には触れない）。 -->
            <Grid>
                <TextBox x:Name="QueryBox"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=80}"
                         FontFamily="{Binding Source={x:Static vm:HeadwordFontState.Instance}, Path=Family}"
                         v:Placeholder.Text="見出し語を入力"
                         Padding="30,6,32,6" />
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="{StaticResource Muted}" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="12,0,0,0" IsHitTestVisible="False" />
                <Button Content="✕" Style="{StaticResource IconButton}" Width="26" Height="24"
                        HorizontalAlignment="Right" Margin="0,0,5,0"
                        Command="{Binding ClearQueryCommand}"
                        Visibility="{Binding Query, Converter={StaticResource NullVis}}" />
            </Grid>

            <!-- 条件はカードにまとめる。見出しラベルはチップと同じ行に置き、
                 「ラベル1行＋チップ1行」の縦積みをやめて一覧の表示件数を稼ぐ。 -->
            <Border Style="{StaticResource FilterCard}" Margin="0,10,0,0">
                <StackPanel>
                    <WrapPanel>
                        <ToggleButton Style="{StaticResource Chip}" Content="前方" Command="{Binding SetModeCommand}" CommandParameter="Forward"
                                      IsChecked="{Binding SearchMode, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Forward}" />
                        <ToggleButton Style="{StaticResource Chip}" Content="部分" Command="{Binding SetModeCommand}" CommandParameter="Partial"
                                      IsChecked="{Binding SearchMode, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Partial}" />
                        <ToggleButton Style="{StaticResource Chip}" Content="後方" Command="{Binding SetModeCommand}" CommandParameter="Backward"
                                      IsChecked="{Binding SearchMode, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Backward}" />
                        <ToggleButton Style="{StaticResource Chip}" Content="完全" Command="{Binding SetModeCommand}" CommandParameter="Exact"
                                      IsChecked="{Binding SearchMode, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Exact}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,7,0,0">
                        <ToggleButton Style="{StaticResource Chip}" Content="見出し語" Command="{Binding SetScopeCommand}" CommandParameter="Form"
                                      IsChecked="{Binding SearchScope, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Form}" />
                        <ToggleButton Style="{StaticResource Chip}" Content="訳語" Command="{Binding SetScopeCommand}" CommandParameter="Translation"
                                      IsChecked="{Binding SearchScope, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Translation}" />
                        <ToggleButton Style="{StaticResource Chip}" Content="両方" Command="{Binding SetScopeCommand}" CommandParameter="Both"
                                      IsChecked="{Binding SearchScope, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Both}" />
                        <ToggleButton Style="{StaticResource Chip}" Content="全文" Command="{Binding SetScopeCommand}" CommandParameter="FullText"
                                      IsChecked="{Binding SearchScope, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=FullText}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Margin="0,8,0,12">
            <!-- 横スクロールは封じる。1 行に収まらない見出し語は末尾を … で省略する -->
            <ListBox x:Name="ResultList"
                     ItemsSource="{Binding FilteredWords}"
                     SelectedItem="{Binding SelectedWord}"
                     MouseDoubleClick="ResultList_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <!-- 行のどこを右クリックしても同じ操作メニューを開く（⋯ を掴む代わりの近道）。
                     ListBoxItem 側に付けるのが要点: DataTemplate の Grid に付けると、
                     ListBoxItem の Padding（行の余白部分）が Grid の外側になり、そこを叩いても反応しない。 -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <EventSetter Event="MouseRightButtonUp" Handler="Row_MouseRightButtonUp" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:Word}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <!-- 見出し語・訳語とも 1 行に収める。既定スタイルの Wrap のままだと
                                     折り返しが優先されて TextTrimming が働かず、行の高さも一定にならない
                                     （MaxHeight で切ると文字サイズ倍率を上げたときに字が縦に欠ける） -->
                                <TextBlock Text="{Binding DisplayForm}"
                                           FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=16}"
                                           FontFamily="{Binding Source={x:Static vm:HeadwordFontState.Instance}, Path=Family}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TranslationSummary}" Foreground="{StaticResource Muted}"
                                           FontSize="{Binding Source={x:Static vm:FontScaleState.Instance}, Path=Scale, Converter={StaticResource ScaleFont}, ConverterParameter=12}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <!-- 中身（編集・複製・削除）は開く直前に Opening で詰める。
                                 ComboBox 等と同じく Popup は使えない（OBS のウィンドウキャプチャに映らない）ため
                                 v:MenuButton の自前ドロップダウンを流用し、右クリックの近道もこれを開くだけにする。 -->
                            <v:MenuButton Grid.Column="1" Header="⋯" Style="{StaticResource RowMenuButton}"
                                          VerticalAlignment="Center"
                                          Opening="RowMenu_Opening" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 0 件のときに白紙だけ残すと「動いていない」ように見えるため、理由を添える。
                 FilteredWords は get-only なのでバインドしても再評価されない。ListBox の Items.Count
                 （ItemCollection）は Count の変更を通知するので、そちらを見る -->
            <StackPanel VerticalAlignment="Center"
                        Visibility="{Binding Items.Count, ElementName=ResultList, Converter={StaticResource CountVis}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource EmptyState}" Text="該当する見出し語はありません" />
                <TextBlock Style="{StaticResource EmptyState}" Margin="24,4,24,0" Opacity="0.75"
                           Text="検索モードを「部分」、対象を「全文」にしてみてください" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
